<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Раздел сайта</span>
    <h1>Контакты</h1>
  </div>
</section>
<section class="section-pad section-pad--tight">
  <div class="container stack">
    <div class="panel legal-body">
      <h2>Реквизиты</h2>
      <dl class="legal-dl">
        <dt>Наименование</dt><dd><%= op.name %></dd>
        <dt>Адрес</dt><dd><%= op.address %></dd>
        <dt>ОГРН</dt><dd><%= op.ogrn %></dd>
        <dt>ИНН</dt><dd><%= op.inn %></dd>
        <dt>КПП</dt><dd><%= op.kpp %></dd>
        <dt><%= op.head.title %></dt><dd><%= op.head.name %></dd>
        <dt>Ответственный за организацию обработки персональных данных (ст. 22.1 152-ФЗ)</dt><dd><%= op.responsible.name %>, <%= op.responsible.title %></dd>
        <dt>Электронная почта</dt><dd><a href="mailto:<%= op.email %>"><%= op.email %></a></dd>
        <dt>Телефон</dt><dd><a href="tel:<%= op.phoneHref %>"><%= op.phone %></a></dd>
        <% if (maxUrl) { %><dt>Мессенджер</dt><dd><a class="btn btn--secondary btn--small btn--max" href="<%= maxUrl %>" rel="noopener" target="_blank">Написать в MAX ↗</a></dd><% } %>
      </dl>
    </div>
    <div class="panel">
      <h2>Как добраться</h2>
      <%
      /* Карта — ССЫЛКОЙ, а не встроенным фреймом: сторонний iframe запрещён
         строгим CSP (frame-src отсутствует), и он же тянул бы к нам чужие
         счётчики. Ссылка ведёт наружу и ничего не грузит на страницу. */
      %>
      <p><%= op.address %></p>
      <p>
        <a class="link-more" rel="nofollow noopener"
           href="https://yandex.ru/maps/?text=<%= encodeURIComponent(op.address) %>">
          Открыть на карте <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
    <div class="panel">
      <h2>По вопросам обработки персональных данных</h2>
      <p class="muted">
        Обращения субъектов персональных данных — на <a href="mailto:<%= op.email %>"><%= op.email %></a>
        или по адресу <%= op.address %>. Порядок и сроки описаны в
        <a href="/privacy">Политике обработки персональных данных</a>.
      </p>
    </div>
    <div class="panel form-panel" id="feedback">
      <h2>Написать нам</h2>
      <% if (!intakeEnabled) { %>
        <p class="muted">Приём обращений через сайт временно закрыт — пишите на <a href="mailto:<%= op.email %>"><%= op.email %></a>.</p>
      <% } else if (sent) { %>
        <p class="notice"><strong>Обращение отправлено.</strong> Ответим на указанный адрес; срок рассмотрения — до 30 дней (п. 12 Политики).</p>
      <% } else { %>
        <% if (feedbackError) { %><p class="notice notice--error"><%= feedbackError %></p><% } %>
        <form method="post" action="/contacts/feedback" class="stacked-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%
          /* Honeypot: поле скрыто стилем, человек его не увидит; бот заполнит — отсев в маршруте. */
          %>
          <div class="hp-field" aria-hidden="true"><label for="fb-website">Сайт</label><input id="fb-website" name="website" tabindex="-1" autocomplete="off"></div>
          <div class="field"><label for="fb-name">Как к вам обращаться</label><input id="fb-name" name="name" maxlength="120" required value="<%= feedbackDraft ? feedbackDraft.name : '' %>"></div>
          <div class="field"><label for="fb-email">E-mail для ответа</label><input id="fb-email" name="email" type="email" maxlength="200" required value="<%= feedbackDraft ? feedbackDraft.email : '' %>"></div>
          <div class="field"><label for="fb-message">Сообщение</label><textarea id="fb-message" name="message" rows="5" minlength="5" maxlength="2000" required></textarea></div>
          <label class="check">
            <input type="checkbox" name="consent_processing" value="1" required>
            <span>Даю согласие на обработку указанных данных (имя, e-mail, текст) для ответа на обращение и ознакомлен с
              <a href="/privacy" target="_blank" rel="noopener">Политикой обработки персональных данных</a>.</span>
          </label>
          <button class="btn btn--primary" type="submit">Отправить</button>
        </form>
      <% } %>
    </div>
  </div>
</section>
</main>
<%- include('partials/footer') %>
