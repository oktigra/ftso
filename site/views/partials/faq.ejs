<%
/* ВОПРОСЫ И ОТВЕТЫ в подвале: первые четыре раскрывающихся пункта, остальное — на /faq.
   Не показывается в админке, кабинете и на самой странице /faq. */
const list = (typeof faqShort !== 'undefined' && faqShort) ? faq.slice(0, 4) : faq;
%>
<div class="footer-faq">
  <h4>Вопросы и ответы</h4>
  <% list.forEach(function (item) { %>
    <details class="faq-item">
      <summary><%= item.q %></summary>
      <%
      const links = [['«Организаторам»', '/organizers'], ['«Документы»', '/documents'], ['«Корты»', '/courts'], ['«Клубы»', '/clubs'], ['«Тренеры»', '/coaches']];
      let html = item.a.replace(/&/g, '&amp;').replace(/</g, '&lt;');
      links.forEach(function (l) { html = html.split(l[0]).join('<a href="' + l[1] + '">' + l[0] + '</a>'); });
      html = html.replace(/info@ftso67\.ru/g, '<a href="mailto:info@ftso67.ru">info@ftso67.ru</a>');
      %>
      <p><%- html %></p>
    </details>
  <% }); %>
  <% if (typeof faqShort !== 'undefined' && faqShort) { %>
    <p class="table-foot"><a class="link-more" href="/faq">Все вопросы <span aria-hidden="true">→</span></a></p>
  <% } %>
</div>
