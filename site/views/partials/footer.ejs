<footer class="site-footer" id="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/"><%- include('brand') %></a>
        <p class="footer-about">Официальный портал региональной общественной спортивной организации. Развитие тенниса в Смоленской области.</p>
      </div>
      <div class="footer-col">
        <h4>Разделы</h4>
        <ul>
          <% footerSections.forEach(function (item) { %>
            <li><a href="<%= item.path %>"><%= item.title %></a></li>
          <% }); %>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Участникам</h4>
        <%
        /* ⚠ ТОЛЬКО ВИД: личный кабинет, заявка на турнир и приём документов —
           ВНЕ ОБЪЁМА договора (§9). В макете это href="#", так и оставлено;
           функционал НЕ строится (отдельный этап позже). */
        %>
        <ul>
          <% footerParticipants.forEach(function (item) { %>
            <li><a href="<%= item.href %>"><%= item.title %></a></li>
          <% }); %>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Контакты</h4>
        <%
        /* Реквизиты — из server/lib/legal.mjs, не вписаны сюда руками: телефон и
           адрес в подвале обязаны совпадать с юр-страницами, иначе это выглядит
           как недостоверные контакты оператора. */
        %>
        <address>
          <%= operator.name %><br>
          ОГРН <%= operator.ogrn %>, ИНН <%= operator.inn %><br>
          <%= operator.address %><br>
          <a href="mailto:<%= operator.email %>"><%= operator.email %></a><br>
          <a href="tel:<%= operator.phoneHref %>"><%= operator.phone %></a>
        </address>
        <% if (maxUrl) { %>
          <p class="footer-max"><a class="btn btn--secondary btn--small btn--max" href="<%= maxUrl %>" rel="noopener" target="_blank">Написать в MAX ↗</a></p>
        <% } %>
      </div>
    </div>
    <%
    /* ФОРМА ОБРАТНОЙ СВЯЗИ ВНИЗУ КАЖДОЙ СТРАНИЦЫ (решение владельца 06.09.2026): та же
       форма, что на /contacts (маршрут /contacts/feedback, honeypot, согласие, лимит).
       Не показывается в админке и на самой странице /contacts (там она уже есть). */
    %>
    <% const noFooterForm = ['/admin', '/contacts', '/cabinet', '/judge', '/register', '/tournament-request', '/login'].some(function (p) { return currentPath.startsWith(p); }); %>
    <% if (typeof intakeEnabled !== 'undefined' && intakeEnabled && !noFooterForm) { %>
      <div class="footer-feedback" id="feedback">
        <h4>Написать в Федерацию</h4>
        <form method="post" action="/contacts/feedback" class="footer-feedback__form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="hp-field" aria-hidden="true"><label for="ff-website">Сайт</label><input id="ff-website" name="website" tabindex="-1" autocomplete="off"></div>
          <div class="field"><label for="ff-name">Как к вам обращаться</label><input id="ff-name" name="name" maxlength="120" required autocomplete="name"></div>
          <div class="field"><label for="ff-email">E-mail для ответа</label><input id="ff-email" name="email" type="email" maxlength="200" required autocomplete="email"></div>
          <div class="field field--wide"><label for="ff-message">Сообщение</label><textarea id="ff-message" name="message" rows="3" minlength="5" maxlength="2000" required></textarea></div>
          <label class="check">
            <input type="checkbox" name="consent_processing" value="1" required>
            <span>Даю согласие на обработку указанных данных (имя, e-mail, текст) для ответа на обращение и ознакомлен с <a href="/privacy">Политикой обработки персональных данных</a>.</span>
          </label>
          <button class="btn btn--primary" type="submit">Отправить</button>
        </form>
      </div>
    <% } %>
    <% if (typeof partners !== 'undefined' && !currentPath.startsWith('/admin') && currentPath !== '/') { %>
      <%- include('partners', { partnersCompact: true, partners, partnersTitle, partnersCta }) %>
    <% } %>
    <div class="footer-bottom">
      <span>© <%= year %> РФСОО «Федерация тенниса Смоленской области»</span>
      <%
      /* 152-ФЗ: эти две ссылки В объёме и ведут на РЕАЛЬНЫЕ страницы, не на «#». */
      %>
      <div class="footer-legal">
        <% footerLegal.forEach(function (item) { %>
          <a href="<%= item.path %>"><%= item.title %></a>
        <% }); %>
        <% if (typeof metrikaId !== 'undefined' && metrikaId) { %>
          <a href="/privacy#cookies" data-cookie-settings>Настройки cookie</a>
        <% } %>
      </div>
    </div>
  </div>
</footer>
<% if (typeof metrikaId !== 'undefined' && metrikaId) { %>
  <%
  /* БАННЕР СОГЛАСИЯ НА АНАЛИТИКУ. Показывается, пока посетитель не решил.
     Счётчик Метрики грузится ТОЛЬКО после «Принять» (см. app.js), до этого
     на сайте нет ни одного запроса к Яндексу. «Отклонить» — тоже на год.
     Выбор — cookie ftso.analytics (техническая: хранит само решение). */
  %>
  <div class="cookie-bar" data-cookie-bar data-metrika="<%= metrikaId %>" data-choice="<%= analyticsChoice %>"<%= analyticsChoice ? ' hidden' : '' %> role="region" aria-label="Согласие на аналитику">
    <p>Мы используем Яндекс.Метрику, чтобы понимать, какие разделы сайта востребованы. Счётчик включится только с вашего согласия;
      без него на сайте работают лишь технически необходимые cookie. Подробнее — в
      <a href="/privacy#cookies">Политике</a>, раздел 8.</p>
    <div class="cookie-bar__actions">
      <button class="btn btn--primary btn--small" type="button" data-cookie-accept>Принять</button>
      <button class="btn btn--secondary btn--small" type="button" data-cookie-decline>Отклонить</button>
    </div>
  </div>
<% } %>
<script src="/static/js/app.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
