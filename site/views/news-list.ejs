<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Раздел сайта</span>
    <h1>Новости</h1>
  </div>
</section>
<section class="section-pad section-pad--tight">
  <div class="container">
    <form method="get" action="/news" class="filters" aria-label="Поиск по новостям">
      <div class="field field--wide">
        <label for="news-q">Поиск по новостям</label>
        <input id="news-q" type="search" name="q" value="<%= q %>" maxlength="80" placeholder="слово из заголовка или текста">
      </div>
      <div class="field"><button class="btn btn--secondary" type="submit">Найти</button></div>
      <% if (q) { %><div class="field"><a class="btn btn--secondary" href="/news">Сбросить</a></div><% } %>
    </form>
    <% if (!news.length) { %>
      <div class="panel notice"><%= q ? 'По запросу «' + q + '» ничего не найдено.' : 'Новостей пока нет.' %></div>
    <% } else { %>
      <div class="news-grid">
        <% news.forEach(function (n) { %>
          <article class="news-card fx-card">
            <% if (n.cover_upload_id) { %><a href="/news/<%= n.id %>" class="news-card-cover"><img src="/news/<%= n.id %>/cover" alt="" loading="lazy"></a><% } else { %><%- include('partials/court-card') %><% } %>
            <span class="news-date"><%= n.published_at || n.created_at.slice(0, 10) %></span>
            <h2 class="news-card-title"><a href="/news/<%= n.id %>"><%= n.title %></a></h2>
            <p><%= n.summary || '' %></p>
            <a class="link-more" href="/news/<%= n.id %>">Читать <span aria-hidden="true">→</span></a>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
</main>
<%- include('partials/footer') %>
