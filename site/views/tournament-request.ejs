<%
/* ЗАЯВКА «ПРОВЕСТИ ТУРНИР». Только POST и enctype multipart — иначе браузер
   отправит одни имена файлов вместо содержимого.
   Значения возвращаются из черновика в сессии; файлы браузер повторно не
   отдаёт, поэтому про это сказано прямым текстом, а не подразумевается. */
%>
<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Организаторам</span>
    <h1>Провести турнир</h1>
    <p class="muted">Заявка на включение соревнования в календарь Федерации. Решение принимает секретарь.</p>
  </div>
</section>

<section class="section-pad section-pad--tight">
  <div class="container">
    <div class="panel form-panel">
      <% if (errors.length) { %>
        <div class="form-errors" role="alert">
          <p><strong>Заявка не отправлена.</strong> Исправьте, пожалуйста:</p>
          <ul>
            <% errors.forEach(function (e) { %><li><%= e %></li><% }); %>
          </ul>
          <p class="muted">Текстовые поля сохранены. Файлы придётся выбрать заново — браузер не отдаёт их повторно.</p>
        </div>
      <% } %>

      <form method="post" action="/tournament-request" class="stacked-form" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field">
          <label for="t-name">Название турнира <span class="req" aria-hidden="true">*</span></label>
          <input id="t-name" name="name" maxlength="160" required value="<%= values.name || '' %>">
        </div>

        <div class="field">
          <label for="t-city">Город проведения <span class="req" aria-hidden="true">*</span></label>
          <input id="t-city" name="city" maxlength="80" required value="<%= values.city || '' %>">
        </div>

        <div class="field">
          <label for="t-date">Дата завершения <span class="req" aria-hidden="true">*</span></label>
          <input id="t-date" name="end_date" placeholder="ГГГГ-ММ-ДД" required
                 aria-describedby="t-date-hint" value="<%= values.end_date || '' %>">
          <p class="field-hint" id="t-date-hint">Дата последнего игрового дня — по ней турнир попадает в рейтинговое окно.</p>
        </div>

        <div class="field">
          <label for="t-category">Категория <span class="req" aria-hidden="true">*</span></label>
          <select id="t-category" name="category" required aria-describedby="t-cat-hint">
            <option value="">— выберите —</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c %>"<%= values.category === c ? ' selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
          <p class="field-hint" id="t-cat-hint">Категория задаёт рейтинговый коэффициент. Итоговую категорию подтверждает Федерация.</p>
        </div>

        <div class="field">
          <label for="t-agelimit">Возрастное ограничение</label>
          <select id="t-agelimit" name="age_limit" data-age-select aria-describedby="t-age-hint">
            <option value="none">без ограничения — открытый турнир</option>
            <% agePresets.forEach(function (p) { %>
              <option value="<%= p.id %>"<%= values.age_limit === p.id ? ' selected' : '' %>><%= p.label %></option>
            <% }); %>
            <option value="custom"<%= values.age_limit === 'custom' ? ' selected' : '' %>>свои границы</option>
          </select>
          <p class="field-hint" id="t-age-hint">Возраст считается как в календаре РТТ: год турнира минус год рождения. «До 13 лет» — это те, кому в год турнира исполняется 12 и меньше.</p>
        </div>

        <div class="field" data-age-custom<%= values.age_limit === 'custom' ? '' : ' hidden' %>>
          <span class="field-hint">Возраст: полных лет в год турнира</span>
          <span class="inline-form">
            <label for="t-agemin">от</label>
            <input id="t-agemin" name="age_min" inputmode="numeric" maxlength="3" size="4" value="<%= values.age_min || '' %>">
            <label for="t-agemax">до</label>
            <input id="t-agemax" name="age_max" inputmode="numeric" maxlength="3" size="4" value="<%= values.age_max || '' %>">
          </span>
        </div>

        <div class="field">
          <label for="t-organizer">Организатор — ФИО или организация <span class="req" aria-hidden="true">*</span></label>
          <input id="t-organizer" name="organizer" maxlength="160" required value="<%= values.organizer || '' %>">
        </div>

        <div class="field">
          <label for="t-email">Электронная почта <span class="req" aria-hidden="true">*</span></label>
          <input id="t-email" name="email" type="email" maxlength="160" required
                 aria-describedby="t-email-hint" value="<%= values.email || '' %>">
          <p class="field-hint" id="t-email-hint">Для ответа по заявке. В открытом доступе не публикуется.</p>
        </div>

        <div class="field">
          <label for="t-phone">Телефон</label>
          <input id="t-phone" name="phone" maxlength="40" value="<%= values.phone || '' %>">
          <p class="field-hint">Необязательно — только если удобнее по телефону.</p>
        </div>

        <div class="field">
          <label for="t-comment">Комментарий</label>
          <input id="t-comment" name="comment" maxlength="1000" value="<%= values.comment || '' %>">
        </div>

        <fieldset class="consent-box">
          <legend>Документы</legend>
          <%
            // ОДНА НАКОПИТЕЛЬНАЯ ЗОНА (замечание владельца 18.09.2026): документы добавляются по
            // одному — выбором или перетаскиванием — до maxFiles штук, у каждого своя кнопка
            // «Удалить». Сервер принимает до maxFiles файлов под любым именем поля.
          %>
          <div class="field">
            <label for="t-docs">Положение, сетка, регламент</label>
            <div class="file-drop file-drop--multi" data-file-drop data-file-max="<%= maxFiles %>">
              <input id="t-docs" name="docs" type="file" multiple class="file-drop__input" aria-describedby="t-doc-hint">
              <label class="file-drop__zone" for="t-docs">
                <span class="file-drop__icon" aria-hidden="true"></span>
                <span class="file-drop__text"><b>Добавить файл</b><span class="file-drop__or"> или перетащите сюда</span></span>
                <span class="file-drop__meta">до <%= maxFiles %> файлов · каждый до <%= maxFileMb %> МБ</span>
              </label>
              <ul class="file-drop__list" data-file-list hidden></ul>
            </div>
          </div>
          <p class="field-hint" id="t-doc-hint">
            До <%= maxFiles %> файлов, каждый не больше <%= maxFileMb %> МБ. Принимаются PDF, документы
            Office и изображения. Тип проверяется по содержимому файла, а не по расширению.
            <strong>Результаты матчей файлом не принимаются</strong> — их вносит секретарь Федерации,
            иначе рейтинг не посчитается.
          </p>
        </fieldset>

        <%
        /* Приманка для ботов: человек её не видит и табом не достанет. */
        %>
        <div class="hp-field" aria-hidden="true">
          <label for="t-website">Не заполняйте это поле</label>
          <input id="t-website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>

        <fieldset class="consent-box">
          <legend>Согласие</legend>
          <div class="check">
            <input type="checkbox" id="t-consent" name="consent_processing" value="1"
                   <%= values.consent_processing ? 'checked' : '' %>>
            <label for="t-consent">
              Даю согласие на <a href="/consent#processing" target="_blank" rel="noopener">обработку
              персональных данных</a> организатора (ФИО, почта, телефон) для рассмотрения заявки
              и ознакомлен с <a href="/privacy" target="_blank" rel="noopener">Политикой</a>.
              <span class="req" aria-hidden="true">*</span>
            </label>
          </div>
          <p class="field-hint">
            Контакты организатора на сайте не публикуются, поэтому отдельного согласия на
            распространение здесь не требуется. Отозвать согласие можно письмом на
            <a href="mailto:<%= op.email %>"><%= op.email %></a>.
          </p>
        </fieldset>

        <%- include('partials/form-check', { pref: 't' }) %>
        <button class="btn btn--primary" type="submit">Отправить заявку</button>
      </form>
    </div>
  </div>
</section>
</main>

<%- include('partials/footer') %>
