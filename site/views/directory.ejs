<%
/* Справочник — ОДИН шаблон на все четыре раздела: поля берутся из описания
   раздела (server/lib/directories.mjs), а не дублируются вёрсткой. */
%>
<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Раздел сайта</span>
    <h1><%= spec.title %></h1>
    <% if (typeof intro !== 'undefined' && intro && intro.length) { %><div class="lead dir-intro"><% intro.forEach(function (p) { %><p><%= p %></p><% }); %></div><% } %>
    <%
    /* Тренер может подать сведения сам: анкета собирает согласие по ст. 10.1 с
       отметками по каждому полю, публикует секретарь после проверки. */
    %>
    <% if (spec.key === 'coaches') { %>
      <p class="dir-actions"><a class="btn btn--secondary btn--small" href="/coaches/apply">Заполнить анкету тренера</a>
        <span class="muted small">Вы сами отмечаете, что публиковать: телефон и место работы — по желанию.</span></p>
    <% } %>
    <% if (spec.key === 'referees') { %>
      <p class="dir-actions"><a class="btn btn--secondary btn--small" href="/referees/apply">Заполнить анкету судьи</a>
        <span class="muted small">Категория, роли на турнирах и опыт — вы сами отмечаете, что показывать.</span></p>
    <% } %>
  </div>
</section>
<section class="section-pad section-pad--tight">
  <div class="container">
    <%
    /* Фильтры по полям filter:true из описания раздела (ТЗ 4.5/4.6). GET-форма без JS. */
    const filterFields = spec.fields.filter(function (f) { return f.filter; });
    const anyFilter = filterFields.some(function (f) { return filters[f.name]; });
    %>
    <% if (filterFields.length && (rows.length || anyFilter)) { %>
      <form method="get" action="<%= spec.path %>" class="filters" aria-label="Фильтры раздела">
        <% filterFields.forEach(function (f) { %>
          <div class="field">
            <label for="df-<%= f.name %>"><%= f.label %></label>
            <select id="df-<%= f.name %>" name="<%= f.name %>">
              <option value="">все</option>
              <% (options[f.name] || []).forEach(function (v) { %><option value="<%= v %>"<%= filters[f.name] === v ? ' selected' : '' %>><%= v %></option><% }); %>
            </select>
          </div>
        <% }); %>
        <div class="field"><button class="btn btn--secondary" type="submit">Показать</button></div>
        <% if (anyFilter) { %><div class="field"><a class="btn btn--secondary" href="<%= spec.path %>">Сбросить</a></div><% } %>
      </form>
    <% } %>
    <% if (!rows.length) { %>
      <div class="panel notice"><%= anyFilter ? 'По выбранным фильтрам записей нет.' : 'Записей пока нет — реестр формируется.' %></div>
    <% } else { %>
      <%
      /* КАРТОЧКИ ВМЕСТО ТАБЛИЦЫ (08.09.2026): оформление главной доехало и сюда.
         Шаблон по-прежнему ОДИН на четыре раздела — карточка собирается из того же
         описания (server/lib/directories.mjs), первое поле идёт заголовком, остальные
         заполненные — парами «подпись — значение». Пустые поля не печатаются: в
         таблице на их месте стоял прочерк, в карточке он был бы шумом.
         Спец-виды значений (профиль игрока, карта, адрес, сайт) сохранены как были. */
      const titleField = spec.fields[0];
      const restFields = spec.fields.slice(1);
      const filled = (row, f) => (f.player ? Boolean(row.player) : Boolean(row[f.name]));
      %>
      <ul class="dir-cards">
        <% rows.forEach(function (row) { %>
          <li class="dir-card fx-card"><%- include('partials/court-card') %>
            <% if (spec.photo && row.photo_upload_id) { %>
              <span class="dir-card__photo"><img src="<%= spec.path %>/<%= row.id %>/photo" alt="" loading="lazy" width="72" height="72"></span>
            <% } %>
            <h2 class="dir-card__title"><%= row[titleField.name] || '—' %></h2>
            <dl class="dir-card__facts">
              <% restFields.forEach(function (f) { if (!filled(row, f)) return; %>
                <dt><%= f.label %></dt>
                <dd>
                  <% if (f.player) { %>
                    <a href="/player/<%= row.player.id %>">профиль игрока <span aria-hidden="true">→</span></a>
                  <% } else if (f.name === 'map_url') { %>
                    <a href="<%= row[f.name] %>" rel="nofollow noopener" target="_blank">на карте ↗</a>
                  <% } else if (f.name === 'address' && !row.map_url) { %>
                    <%= row[f.name] %> · <a href="https://yandex.ru/maps/?text=<%= encodeURIComponent(row[f.name]) %>" rel="nofollow noopener" target="_blank">на карте ↗</a>
                  <% } else if (f.name === 'site') { %>
                    <a href="<%= row[f.name] %>" rel="nofollow noopener"><%= row[f.name] %></a>
                  <% } else { %><%= row[f.name] %><% } %>
                </dd>
              <% }); %>
            </dl>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</section>
</main>
<%- include('partials/footer') %>
