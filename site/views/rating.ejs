<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Региональный рейтинг</span>
    <h1>Рейтинг игроков</h1>
    <% if (standings) { %>
      <div class="rating-meta">
        <span class="tag"><%= statusText %></span>
        <span class="tag">актуальность: <%= standings.asOf %></span>
        <span class="tag">обновлён: <%= standings.computedAt %> UTC</span>
        <span class="tag">разряд: <%= disciplineRu[filters.discipline] %></span>
        <% if (slice) { %><span class="tag">срез: <%= slice.label %></span><% } %>
      </div>
    <% } %>
  </div>
</section>

<section class="section-pad section-pad--tight">
  <div class="container">
    <% if (!standings) { %>
      <%
      /* Пустой rating_cache: ни разу не считали -> сообщение, а не 500. */
      %>
      <div class="panel empty-state">
        <h2>Рейтинг ещё не рассчитан</h2>
        <p class="muted">Таблица появится после первого пересчёта в админке Федерации.</p>
      </div>
    <% } else { %>
      <form class="filters" method="get" action="/rating">
        <div class="field field--wide">
          <label for="f-q">Поиск по фамилии</label>
          <input id="f-q" type="search" name="q" value="<%= filters.q %>" placeholder="например, Ковалёв" maxlength="120">
        </div>
        <div class="field">
          <label for="f-age">Возрастная группа</label>
          <select id="f-age" name="age">
            <option value="">все</option>
            <% ageGroups.forEach(function (g) { %>
              <option value="<%= g %>"<%= filters.age === g ? ' selected' : '' %>><%= g %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="f-slice">Возраст (срез)</label>
          <select id="f-slice" name="slice">
            <option value="">все возрасты</option>
            <% ageSlices.forEach(function (s) { %>
              <option value="<%= s.id %>"<%= filters.slice === s.id ? ' selected' : '' %>><%= s.label %></option>
            <% }); %>
          </select>
        </div>
        <% if (hasDoubles) { %>
        <div class="field">
          <label for="f-discipline">Разряд</label>
          <select id="f-discipline" name="discipline">
            <option value="single"<%= filters.discipline === 'single' ? ' selected' : '' %>>одиночный</option>
            <option value="double"<%= filters.discipline === 'double' ? ' selected' : '' %>>парный</option>
          </select>
        </div>
        <% } else if (filters.discipline === 'double') { %>
          <input type="hidden" name="discipline" value="double">
        <% } %>
        <div class="field">
          <label for="f-sex">Пол</label>
          <select id="f-sex" name="sex">
            <option value="">все</option>
            <% sexes.forEach(function (s) { %>
              <option value="<%= s %>"<%= filters.sex === s ? ' selected' : '' %>><%= sexRu[s] %></option>
            <% }); %>
          </select>
        </div>
        <button class="btn btn--primary" type="submit">Показать</button>
        <a class="btn btn--secondary" href="/rating">Сбросить</a>
      </form>

      <p class="rating-summary muted">
        Показано <%= players.length %> из <%= total %> игроков.
        Выгрузить:
        <a class="link-more" href="/rating.xlsx?<%= new URLSearchParams(filters).toString() %>">Excel</a> ·
        <a class="link-more" href="/rating/print?<%= new URLSearchParams(filters).toString() %>" target="_blank" rel="noopener">PDF (печать)</a> ·
        <a class="link-more" href="/rating.csv?<%= new URLSearchParams(filters).toString() %>">CSV</a>
      </p>

      <% if (players.length === 0) { %>
        <div class="panel notice">По заданным фильтрам игроков не найдено.</div>
      <% } else { %>
        <div class="table-scroll">
          <table class="rating-table">
            <thead><tr><th>Место</th><th>Игрок</th><th>Город</th><th>Пол</th><th>Возраст</th><th>Группа</th><th>Очки</th><th>Изменение</th></tr></thead>
            <tbody>
              <% players.forEach(function (p) { %>
                <tr>
                  <td class="rank"><%= p.rank %><% if (p.overallRank && p.overallRank !== p.rank) { %> <span class="muted">(<%= p.overallRank %>)</span><% } %></td>
                  <%
                  /* ЭКРАНИРОВАНИЕ: вывод данных из БД — только экранирующим тегом,
                     никогда «сырым». Игрок с именем <script>alert(1)</script>
                     покажется ТЕКСТОМ, скрипт не выполнится.
                     Строка ведёт на публичный профиль /player/:id (как у РТТ);
                     обезличенный по ст. 21 — без ссылки. */
                  %>
                  <td class="player<%= p.anonymized ? ' player--anonymized' : '' %>"><% if (p.anonymized) { %><%= p.playerName %><% } else { %><a href="/player/<%= p.playerId %>"><%= p.playerName %></a><% } %></td>
                  <td><%= p.city || '—' %></td>
                  <td><%= sexRu[p.sex] || p.sex || '—' %></td>
                  <td><%= p.ageLabel %></td>
                  <td><%= p.ageGroup || '—' %></td>
                  <td class="pts"><%= p.ratingPoints %></td>
                  <td class="chg chg--<%= p.change.kind %>"><%= p.change.label %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <p class="rules-note">
        Учитываются <%= rules.countBest %> лучших турниров за последние 52 недели (окно <%= rules.windowDays %> дней),
        коэффициент категории A × <%= rules.categoryCoef.A %>, B × <%= rules.categoryCoef.B %>, C × <%= rules.categoryCoef.C %>,
        шкала очков по местам 100 · 70 · 45 · 25 · 10.
        Рейтинг пересчитывается в начале каждого месяца. Возраст — в полных годах на сегодня;
        в возрастном срезе место считается внутри среза, в скобках — место в общей таблице.
        <% if (!standings.hasPrevious) { %>
          Предыдущего снимка ещё нет, поэтому колонка «Изменение» пуста («—»).
        <% } %>
      </p>
    <% } %>
  </div>
</section>
</main>

<%- include('partials/footer') %>
