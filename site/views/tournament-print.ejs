<%
/* ПЕЧАТНАЯ ВЕРСИЯ ТУРНИРА: шапка турнира, группы, сетка, результаты. Без шапки/подвала
   сайта. Кнопки: печать (Сохранить как PDF), отправить ссылку по почте (mailto). */
%>
<%- include('partials/head') %>
<main id="top" class="print-sheet">
  <div class="container">
    <p class="print-toolbar">
      <a class="btn btn--primary" href="/tournaments/<%= tournament.id %>/bracket.pdf">Скачать PDF</a>
      <a class="btn btn--primary" href="/tournaments/<%= tournament.id %>/bracket.docx">Скачать Word</a>
      <a class="btn btn--secondary" href="/tournaments/<%= tournament.id %>/protocol.xlsx">Протокол Excel</a>
      <button class="btn btn--secondary" type="button" data-print>Напечатать</button>
      <a class="btn btn--secondary" href="/tournaments/<%= tournament.id %>">← к турниру</a>
    </p>
    <h1><%= tournament.name %></h1>
    <p class="muted">
      <%= kindRu[tournament.kind] || 'Турнир' %> · <%= tournament.start_date ? tournament.start_date + ' — ' : '' %><%= tournament.end_date %>
      <%= tournament.city ? ' · ' + tournament.city : '' %> · категория <%= tournament.category %><%= tournament.age_group ? ' · ' + tournament.age_group : '' %> · Федерация тенниса Смоленской области
    </p>

    <% groups.forEach(function (g) { %>
      <h2>Группа <%= g.name %> <span class="muted">(<%= g.kind === 'double' ? 'парный' : 'одиночный' %>)</span></h2>
      <table class="print-table group-table">
        <thead><tr><th>#</th><th>Игрок</th><% g.members.forEach(function (c, j) { %><th><%= j + 1 %></th><% }); %><th>Поб.</th><th>Место</th></tr></thead>
        <tbody>
          <% g.members.forEach(function (r, i) { %>
            <tr>
              <td><%= i + 1 %></td><td><%= r.anonymized_at ? 'Игрок удалён' : r.full_name %></td>
              <% g.members.forEach(function (c) { %>
                <% if (r.id === c.id) { %><td class="group-self">—</td><% } else { const cell = g.cells[r.id + ':' + c.id]; %>
                  <td><%= cell ? (cell.won ? cell.score : cell.score.split(' ').map(function (s) { var m = /^(\d+)[:\-](\d+)(\(\d+\))?$/.exec(s); return m ? m[2] + ':' + m[1] + (m[3] || '') : s; }).join(' ')) : '' %></td>
                <% } %>
              <% }); %>
              <td><%= g.stats[r.id].wins %></td><td><strong><%= g.stats[r.id].played ? g.stats[r.id].place : '—' %></strong></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% }); %>

    <% brackets.forEach(function (b) { %>
      <h2>Сетка «<%= b.name %>» <span class="muted">(на <%= b.size %>, <%= b.kind === 'double' ? 'парный' : 'одиночный' %>)</span></h2>
      <div class="bracket bracket--print">
        <% b.rounds.forEach(function (round) { %>
          <div class="bracket__round">
            <div class="bracket__title"><%= round.name %></div>
            <% round.pairs.forEach(function (p) { %>
              <div class="bracket__pair<%= p.winner ? ' bracket__pair--done' : '' %>">
                <div class="bracket__slot<%= p.winner && p.winner === p.aId ? ' bracket__slot--win' : '' %>"><%= p.a ? p.a.full_name : '—' %></div>
                <div class="bracket__slot<%= p.winner && p.winner === p.bId ? ' bracket__slot--win' : '' %>"><%= p.b ? p.b.full_name : '—' %></div>
                <div class="bracket__score"><%= p.winner ? (p.bye ? 'без игры' : (p.score || '')) : '' %></div>
              </div>
            <% }); %>
          </div>
        <% }); %>
        <div class="bracket__round"><div class="bracket__title">Победитель</div><div class="bracket__pair"><div class="bracket__slot bracket__slot--win"><%= b.champion ? b.champion.full_name : '—' %></div></div></div>
      </div>
    <% }); %>

    <% if (results.length) { %>
      <h2>Результаты</h2>
      <table class="print-table">
        <thead><tr><th>Место</th><th>Игрок</th><th>Город</th></tr></thead>
        <tbody><% results.forEach(function (r) { %><tr><td><%= r.place %></td><td><%= r.name %><%= r.discipline === 'double' ? ' (парный)' : '' %></td><td><%= r.city || '' %></td></tr><% }); %></tbody>
      </table>
    <% } %>
    <% if (!groups.length && !brackets.length && !results.length) { %><p class="muted">Сетка и результаты ещё не внесены.</p><% } %>
    <p class="muted print-foot">ftso67.ru/tournaments/<%= tournament.id %> · сформировано <%= new Date().toISOString().slice(0, 10) %></p>
  </div>
</main>
<script src="/static/js/app.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
