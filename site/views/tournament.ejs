<%
/* КАРТОЧКА ТУРНИРА. Участники и стороны матчей — ссылками на публичный
   профиль /player/:id (ТЗ ред. 6, модель РТТ). Результаты публикуются на
   основании участия, согласие на витрину не влияет; обезличенный по ст. 21 —
   «Игрок удалён» текстом, без ссылки.
   Документы отдаются через /files — вне webroot, attachment, nosniff. */
%>
<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Турнир</span>
    <h1><%= tournament.name %></h1>
    <p class="muted">
      Дата завершения <%= tournament.end_date %> ·
      категория <span class="badge badge--<%= tournament.category.toLowerCase() %>"><%= tournament.category %></span>
    </p>
  </div>
</section>

<section class="section-pad section-pad--tight">
  <div class="container stack">
    <div class="panel">
      <h2>Участники и места</h2>
      <% if (!participants.length) { %>
        <p class="muted">Результаты ещё не внесены.</p>
      <% } else { %>
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">Итоговые места участников</caption>
            <thead><tr><th scope="col">Место</th><th scope="col">Участник</th><th scope="col">Город</th><th scope="col">Разряд</th></tr></thead>
            <tbody>
              <% participants.forEach(function (p) { %>
                <tr>
                  <td class="rank"><%= p.place %></td>
                  <td class="player<%= p.anonymized ? ' player--anonymized' : '' %>"><% if (p.playerId) { %><a href="/player/<%= p.playerId %>"><%= p.name %></a><% } else { %><%= p.name %><% } %></td>
                  <td><%= p.city || '—' %></td>
                  <td><%= p.discipline === 'double' ? 'парный' : 'одиночный' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="panel">
      <h2>Сетка: сыгранные матчи</h2>
      <% if (!matches.length) { %>
        <p class="muted">Матчи ещё не внесены.</p>
      <% } else { %>
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">Сыгранные матчи турнира</caption>
            <thead><tr><th scope="col">Дата</th><th scope="col">Победитель</th><th scope="col">Соперник</th><th scope="col">Счёт</th></tr></thead>
            <tbody>
              <%
              /* Стороны — ссылками на профили; обезличенный (id null) — текстом.
                 Вывод имён только экранирующим тегом. */
              %>
              <% matches.forEach(function (m) { %>
                <tr>
                  <td><%= m.playedOn %></td>
                  <td><% m.winners.forEach(function (r, i) { %><%= i ? ' / ' : '' %><% if (r.id) { %><a href="/player/<%= r.id %>"><%= r.name %></a><% } else { %><%= r.name %><% } %><% }); %></td>
                  <td><% m.losers.forEach(function (r, i) { %><%= i ? ' / ' : '' %><% if (r.id) { %><a href="/player/<%= r.id %>"><%= r.name %></a><% } else { %><%= r.name %><% } %><% }); %></td>
                  <td><%= m.score || '—' %><%= m.kind === 'double' ? ' · пара' : '' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="panel">
      <h2>Документы</h2>
      <% if (!documents.length) { %>
        <p class="muted">Документы к этому турниру не приложены.</p>
      <% } else { %>
        <ul class="doc-list">
          <% documents.forEach(function (d) { %>
            <li>
              <a href="/files/<%= d.id %>"><%= d.doc_title || d.original_name %></a>
              <span class="muted">— <%= Math.max(1, Math.round(d.size_bytes / 1024)) %> КБ</span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <p class="table-foot"><a class="link-more" href="/tournaments">Все турниры <span aria-hidden="true">→</span></a></p>
  </div>
</section>
</main>
<%- include('partials/footer') %>
