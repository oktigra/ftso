<%
/* КАРТОЧКА ТУРНИРА. Участники и стороны матчей — ссылками на публичный
   профиль /player/:id (ТЗ ред. 6, модель РТТ). Результаты публикуются на
   основании участия, согласие на витрину не влияет; обезличенный по ст. 21 —
   «Игрок удалён» текстом, без ссылки.
   Документы отдаются через /files — вне webroot, attachment, nosniff. */
%>
<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Турнир</span>
    <h1><%= tournament.name %></h1>
    <p class="muted">
      <%= tournament.start_date ? 'Даты ' + tournament.start_date + ' — ' + tournament.end_date : 'Дата завершения ' + tournament.end_date %> ·
      <%= tournament.city ? tournament.city + ' · ' : '' %><%= ({team:'командная встреча',championship:'первенство',other:'турнир'})[tournament.kind] || 'турнир' %><%= tournament.age_group ? ' · ' + tournament.age_group : '' %> ·
      категория <span class="badge badge--<%= tournament.category.toLowerCase() %>"><%= tournament.category %></span>
    </p>
  </div>
</section>

<section class="section-pad section-pad--tight">
  <div class="container stack">
    <div class="panel">
      <h2>Участники и места</h2>
      <% if (!participants.length) { %>
        <p class="muted">Результаты ещё не внесены.</p>
      <% } else { %>
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">Итоговые места участников</caption>
            <thead><tr><th scope="col">Место</th><th scope="col">Участник</th><th scope="col">Город</th><th scope="col">Разряд</th></tr></thead>
            <tbody>
              <% participants.forEach(function (p) { %>
                <tr>
                  <td class="rank"><%= p.place %></td>
                  <td class="player<%= p.anonymized ? ' player--anonymized' : '' %>"><% if (p.playerId) { %><a href="/player/<%= p.playerId %>"><%= p.name %></a><% } else { %><%= p.name %><% } %></td>
                  <td><%= p.city || '—' %></td>
                  <td><%= p.discipline === 'double' ? 'парный' : 'одиночный' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <% if (groups.length || brackets.length) { %>
      <p class="inline-form">
        <a class="btn btn--secondary btn--small" href="/tournaments/<%= tournament.id %>/bracket.pdf">Скачать сетку PDF</a>
        <a class="btn btn--secondary btn--small" href="/tournaments/<%= tournament.id %>/bracket.docx">Скачать сетку Word</a>
        <a class="btn btn--secondary btn--small" href="/tournaments/<%= tournament.id %>/print" target="_blank" rel="noopener">Печать</a>
      </p>
    <% } %>
    <% if (groups.length) { %>
      <div class="panel">
        <h2>Групповой этап</h2>
        <% groups.forEach(function (g) { %>
          <h3>Группа <%= g.name %> <span class="muted">(<%= g.kind === 'double' ? 'парный' : 'одиночный' %>)</span></h3>
          <div class="table-scroll">
            <table class="group-table">
              <caption class="visually-hidden">Таблица группы <%= g.name %></caption>
              <thead><tr><th scope="col">#</th><th scope="col">Игрок</th><% g.members.forEach(function (c, j) { %><th scope="col"><%= j + 1 %></th><% }); %><th scope="col">Поб.</th><th scope="col">Место</th></tr></thead>
              <tbody>
                <% g.members.forEach(function (r, i) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td class="player"><% if (r.anonymized_at) { %>Игрок удалён<% } else { %><a href="/player/<%= r.id %>"><%= r.full_name %></a><% } %></td>
                    <% g.members.forEach(function (c) { %>
                      <% if (r.id === c.id) { %><td class="group-self">—</td><% } else { const cell = g.cells[r.id + ':' + c.id]; %>
                        <td class="<%= cell ? (cell.won ? 'group-win' : 'group-loss') : '' %>"><%= cell ? cell.shown : '' %></td>
                      <% } %>
                    <% }); %>
                    <td><%= g.stats[r.id].wins %></td>
                    <td><strong><%= g.stats[r.id].played ? g.stats[r.id].place : '—' %></strong></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (brackets.length) { %>
      <div class="panel">
        <h2>Сетка плей-офф</h2>
        <% brackets.forEach(function (b) { %>
          <h3><%= b.name %> <span class="muted">(на <%= b.size %>, <%= b.kind === 'double' ? 'парный' : 'одиночный' %>)</span></h3>
          <div class="bracket bracket--public">
            <% b.rounds.forEach(function (round) { %>
              <div class="bracket__round">
                <div class="bracket__title"><%= round.name %></div>
                <div class="bracket__pairs">
                <% round.pairs.forEach(function (p) { %>
                  <div class="bracket__pair<%= p.decided ? ' bracket__pair--done' : '' %>">
                    <div class="bracket__slot<%= p.winner && p.winner === p.aId ? ' bracket__slot--win' : '' %>"><%= p.a ? p.a.full_name : '—' %></div>
                    <div class="bracket__slot<%= p.winner && p.winner === p.bId ? ' bracket__slot--win' : '' %>"><%= p.b ? p.b.full_name : '—' %></div>
                    <% if (p.winner || p.void) { %><div class="bracket__score"><%= p.bye ? 'без игры' : (p.score || '') %></div><% } %>
                  </div>
                <% }); %>
              </div>
              </div>
            <% }); %>
            <div class="bracket__round"><div class="bracket__title">Победитель</div><div class="bracket__pairs"><div class="bracket__pair"><div class="bracket__slot bracket__slot--win"><%= b.champion ? b.champion.full_name : '—' %></div></div></div></div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <div class="panel">
      <h2>Сыгранные матчи</h2>
      <% if (!matches.length) { %>
        <p class="muted">Матчи ещё не внесены.</p>
      <% } else { %>
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">Сыгранные матчи турнира</caption>
            <thead><tr><th scope="col">Дата</th><th scope="col">Победитель</th><th scope="col">Соперник</th><th scope="col">Счёт</th></tr></thead>
            <tbody>
              <%
              /* Стороны — ссылками на профили; обезличенный (id null) — текстом.
                 Вывод имён только экранирующим тегом. */
              %>
              <% matches.forEach(function (m) { %>
                <tr>
                  <td><%= m.playedOn %></td>
                  <td><% m.winners.forEach(function (r, i) { %><%= i ? ' / ' : '' %><% if (r.id) { %><a href="/player/<%= r.id %>"><%= r.name %></a><% } else { %><%= r.name %><% } %><% }); %></td>
                  <td><% m.losers.forEach(function (r, i) { %><%= i ? ' / ' : '' %><% if (r.id) { %><a href="/player/<%= r.id %>"><%= r.name %></a><% } else { %><%= r.name %><% } %><% }); %></td>
                  <td><%= m.score || '—' %><%= m.kind === 'double' ? ' · пара' : '' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="panel">
      <h2>Документы</h2>
      <% if (!documents.length) { %>
        <p class="muted">Документы к этому турниру не приложены.</p>
      <% } else { %>
        <ul class="doc-list">
          <% documents.forEach(function (d) { %>
            <li>
              <a href="/files/<%= d.id %>"><%= d.doc_title || d.original_name %></a>
              <span class="muted">— <%= Math.max(1, Math.round(d.size_bytes / 1024)) %> КБ</span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <div class="panel">
      <h2>Фото</h2>
      <% if (!gallery.length) { %>
        <p class="muted">Фотографий с этого турнира пока нет.</p>
      <% } else { %>
        <ul class="gallery-grid">
          <% gallery.forEach(function (g) { %>
            <li><figure><img src="/gallery/<%= g.id %>/image" alt="<%= g.title %>" loading="lazy"><figcaption><%= g.title %></figcaption></figure></li>
          <% }); %>
        </ul>
        <p class="muted">Репортажная съёмка соревнования, публикуется без согласия изображённых (подп. 2 п. 1 ст. 152.1 ГК РФ). Подробнее и как убрать снимок — в <a href="/gallery">галерее</a>.</p>
      <% } %>
    </div>

    <p class="table-foot"><a class="link-more" href="/tournaments">Все турниры <span aria-hidden="true">→</span></a></p>
  </div>
</section>
</main>
<%- include('partials/footer') %>
