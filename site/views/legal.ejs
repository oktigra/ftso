<%
/* 152-ФЗ: страницы В объёме, ссылки в подвале ведут сюда, а не на «#».
   Оболочка общая для /privacy и /consent: шапка страницы, реквизиты оператора
   и подпись редакции — одни и те же, различается только текст (bodyView).
   bodyView задаётся МАРШРУТОМ (значения из кода, не из запроса). */
%>
<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Правовая информация</span>
    <h1><%= heading %></h1>
    <p class="muted"><%= legalVersionLabel %></p>
  </div>
</section>

<section class="section-pad section-pad--tight">
  <div class="container">
    <div class="panel legal-body">
      <p class="muted">
        Оператор персональных данных — <%= op.name %>, <%= op.address %>,
        <a href="mailto:<%= op.email %>"><%= op.email %></a>.
      </p>

      <%- include(bodyView, { op: op, legalVersionLabel: legalVersionLabel }) %>
    </div>

    <div class="panel legal-body legal-requisites">
      <h2>Реквизиты оператора</h2>
      <dl class="legal-dl">
        <dt>Полное наименование</dt>
        <dd><%= op.name %></dd>
        <dt>Адрес</dt>
        <dd><%= op.address %></dd>
        <dt>ОГРН</dt>
        <dd><%= op.ogrn %></dd>
        <dt>ИНН</dt>
        <dd><%= op.inn %></dd>
        <dt>Электронная почта</dt>
        <dd><a href="mailto:<%= op.email %>"><%= op.email %></a></dd>
        <dt>Телефон</dt>
        <dd><a href="tel:<%= op.phoneHref %>"><%= op.phone %></a></dd>
      </dl>
      <p class="muted"><%= legalVersionLabel %>. Действующая редакция публикуется на этой странице.</p>
    </div>
  </div>
</section>
</main>

<%- include('partials/footer') %>
