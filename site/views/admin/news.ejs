<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="top" class="admin-shell">
<div class="container stack">
  <h1>Новости</h1>
  <%- include('_shell') %>

  <div class="panel form-panel">
    <h2>Добавить новость</h2>
    <form method="post" action="/admin/news" class="stacked-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="n-title">Заголовок</label><input id="n-title" name="title" maxlength="200" required></div>
      <div class="field"><label for="n-summary">Короткое описание</label><input id="n-summary" name="summary" maxlength="500"></div>
      <div class="field"><label for="n-body">Текст</label><textarea id="n-body" name="body" rows="6" maxlength="20000" required></textarea></div>
      <div class="field"><label for="n-date">Дата публикации</label><input id="n-date" name="published_at" placeholder="ГГГГ-ММ-ДД"></div>
      <div class="field"><label for="n-author">Автор</label><input id="n-author" name="author" maxlength="120" placeholder="пусто — Федерация"></div>
      <div class="field"><label for="n-cat">Категория</label>
        <select id="n-cat" name="category"><% Object.keys(categories).forEach(function (k) { %><option value="<%= k %>"<%= k === 'federation' ? ' selected' : '' %>><%= categories[k] %></option><% }); %></select></div>
      <div class="field"><label for="n-pub">Публикация</label>
        <select id="n-pub" name="is_published">
          <option value="0" selected>черновик</option>
          <option value="1">опубликовать</option>
        </select>
      </div>
      <button class="btn btn--primary" type="submit">Добавить</button>
    </form>
    <p class="muted">Черновик по прямой ссылке наружу не отдаётся — /news/:id вернёт 404.</p>
  </div>

  <div class="panel">
    <h2>Список (<%= news.length %>)</h2>
    <% if (!news.length) { %><p class="muted">Новостей пока нет.</p><% } %>
    <% news.forEach(function (n) { %>
      <div class="reg-item">
        <form method="post" action="/admin/news/<%= n.id %>/update" class="stacked-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="t-<%= n.id %>">Заголовок</label>
            <input id="t-<%= n.id %>" name="title" maxlength="200" required value="<%= n.title %>"></div>
          <div class="field"><label for="s-<%= n.id %>">Короткое описание</label>
            <input id="s-<%= n.id %>" name="summary" maxlength="500" value="<%= n.summary || '' %>"></div>
          <div class="field"><label for="b-<%= n.id %>">Текст</label>
            <textarea id="b-<%= n.id %>" name="body" rows="4" maxlength="20000" required><%= n.body %></textarea></div>
          <div class="field"><label for="d-<%= n.id %>">Дата публикации</label>
            <input id="d-<%= n.id %>" name="published_at" placeholder="ГГГГ-ММ-ДД" value="<%= n.published_at || '' %>"></div>
          <div class="field"><label for="a-<%= n.id %>">Автор</label>
            <input id="a-<%= n.id %>" name="author" maxlength="120" value="<%= n.author || '' %>" placeholder="пусто — Федерация"></div>
          <div class="field"><label for="c-<%= n.id %>">Категория</label>
            <select id="c-<%= n.id %>" name="category"><% Object.keys(categories).forEach(function (k) { %><option value="<%= k %>"<%= (n.category || 'federation') === k ? ' selected' : '' %>><%= categories[k] %></option><% }); %></select></div>
          <div class="field"><label for="p-<%= n.id %>">Публикация</label>
            <select id="p-<%= n.id %>" name="is_published">
              <option value="0"<%= n.is_published ? '' : ' selected' %>>черновик</option>
              <option value="1"<%= n.is_published ? ' selected' : '' %>>опубликована</option>
            </select>
          </div>
          <div class="inline-form">
            <button class="btn btn--secondary btn--small" type="submit">Сохранить</button>
          </div>
        </form>
        <form method="post" action="/admin/news/<%= n.id %>/delete" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--danger btn--small" type="submit">Удалить</button>
        </form>
        <%
        /* ТЗ 4.2: обложка (изображение), вложения-файлы и ссылки. Отдельные формы —
           multipart для файлов, обычная для ссылки. */
        %>
        <div class="news-extras">
          <form method="post" action="/admin/news/<%= n.id %>/cover" class="inline-form" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label for="cover-<%= n.id %>">Обложка<%= n.cover_upload_id ? ' (есть)' : '' %></label>
              <input id="cover-<%= n.id %>" type="file" name="cover" accept="image/*"></div>
            <button class="btn btn--secondary btn--small" type="submit">Загрузить обложку</button>
          </form>
          <% if (n.cover_upload_id) { %>
            <form method="post" action="/admin/news/<%= n.id %>/cover/delete" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--danger btn--small" type="submit" data-confirm="Снять обложку?">Снять обложку</button>
            </form>
          <% } %>
          <form method="post" action="/admin/news/<%= n.id %>/attachments" class="inline-form" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label for="af-<%= n.id %>">Файл (документ или изображение)</label><input id="af-<%= n.id %>" type="file" name="file"></div>
            <div class="field"><label for="aft-<%= n.id %>">Название</label><input id="aft-<%= n.id %>" name="title" maxlength="160" placeholder="как показать"></div>
            <button class="btn btn--secondary btn--small" type="submit">Прикрепить файл</button>
          </form>
          <form method="post" action="/admin/news/<%= n.id %>/attachments" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label for="al-<%= n.id %>">Ссылка</label><input id="al-<%= n.id %>" name="url" maxlength="500" placeholder="https://…"></div>
            <div class="field"><label for="alt-<%= n.id %>">Название</label><input id="alt-<%= n.id %>" name="title" maxlength="160"></div>
            <button class="btn btn--secondary btn--small" type="submit">Добавить ссылку</button>
          </form>
          <% if (n.attachments && n.attachments.length) { %>
            <ul class="news-attachments">
              <% n.attachments.forEach(function (a) { %>
                <li><%= a.title %> <span class="muted"><%= a.url ? a.url : a.original_name %></span>
                  <form method="post" action="/admin/news/<%= n.id %>/attachments/<%= a.id %>/delete" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--danger btn--small" type="submit" data-confirm="Удалить вложение «<%= a.title %>»?">Удалить</button>
                  </form></li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</div>
</main>
<%- include('../partials/footer') %>
