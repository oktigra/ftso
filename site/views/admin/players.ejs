<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="top" class="admin-shell">
<div class="container stack">
  <h1>Игроки</h1>
  <%- include('_shell') %>

  <div class="panel">
    <h2>Добавить игрока</h2>
    <form method="post" action="/admin/players" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="p-name">ФИО</label><input id="p-name" name="full_name" maxlength="120" required></div>
      <div class="field"><label for="p-city">Город</label><input id="p-city" name="city" maxlength="80" required></div>
      <div class="field"><label for="p-sex">Пол</label>
        <select id="p-sex" name="sex" required>
          <% sexes.forEach(function (s) { %><option value="<%= s %>"><%= s === 'M' ? 'муж.' : 'жен.' %></option><% }); %>
        </select>
      </div>
      <div class="field"><label for="p-age">Возрастная группа</label>
        <select id="p-age" name="age_group">
          <option value="">не указана</option>
          <% ageGroups.forEach(function (g) { %><option value="<%= g %>"><%= g %></option><% }); %>
        </select>
      </div>
      <div class="field"><label for="p-public">Публикация</label>
        <%
        /* Списком, а НЕ чекбоксом: невыбранный чекбокс браузер не отправляет,
           и «снять публикацию» было бы неотличимо от «поле не пришло».
           Дефолт — «скрыт»: публикация требует согласия, а не наоборот. */
        %>
        <select id="p-public" name="is_public">
          <option value="0" selected>скрыт</option>
          <option value="1">публикуется</option>
        </select>
      </div>
      <div class="field"><label for="p-basis">Основание публикации</label>
        <input id="p-basis" name="consent_basis" maxlength="200" placeholder="например: бумажное согласие">
      </div>
      <div class="field"><label for="p-basis-date">Дата согласия</label>
        <input id="p-basis-date" name="consent_document_date" placeholder="ГГГГ-ММ-ДД">
      </div>
      <button class="btn btn--primary" type="submit">Добавить</button>
    </form>
    <p class="muted">
      «Публикуется» ставится, только если получено согласие на распространение
      персональных данных (ст. 10.1 152-ФЗ). Отметка пишется в журнал согласий
      событием с датой; снятие отметки — это отзыв согласия.
      Для игрока, заводимого вручную, ОБЯЗАТЕЛЬНЫ основание и дата документа:
      сама галочка правовым основанием не является. При «скрыт» поля не нужны.
    </p>
  </div>

  <div class="panel">
    <h2>Список (<%= players.length %>)</h2>
    <p class="muted">Поля редактируются прямо в строке — измените и нажмите «Сохранить».</p>
    <%
    /* Формы объявлены ВНЕ таблицы, а поля связаны с ними атрибутом form=
       (вложенные <form> в HTML запрещены, а строка таблицы должна нести
       и сохранение, и удаление). */
    %>
    <div class="table-scroll">
      <table class="admin-table admin-table--edit">
        <thead><tr><th>ID</th><th>ФИО</th><th>Город</th><th>Пол</th><th>Группа</th><th>Публикация</th><th>Действия</th></tr></thead>
        <tbody>
          <% players.forEach(function (p) { %>
            <tr>
              <td><%= p.id %></td>
              <td><input form="edit-player-<%= p.id %>" name="full_name" value="<%= p.full_name %>" maxlength="120" required></td>
              <td><input form="edit-player-<%= p.id %>" name="city" value="<%= p.city %>" maxlength="80" required></td>
              <td>
                <select form="edit-player-<%= p.id %>" name="sex" required>
                  <% sexes.forEach(function (s) { %>
                    <option value="<%= s %>"<%= p.sex === s ? ' selected' : '' %>><%= s === 'M' ? 'муж.' : 'жен.' %></option>
                  <% }); %>
                </select>
              </td>
              <td>
                <select form="edit-player-<%= p.id %>" name="age_group">
                  <option value=""<%= p.age_group ? '' : ' selected' %>>не указана</option>
                  <% ageGroups.forEach(function (g) { %>
                    <option value="<%= g %>"<%= p.age_group === g ? ' selected' : '' %>><%= g %></option>
                  <% }); %>
                </select>
              </td>
              <td>
                <select form="edit-player-<%= p.id %>" name="is_public">
                  <option value="0"<%= p.is_public ? '' : ' selected' %>>скрыт</option>
                  <option value="1"<%= p.is_public ? ' selected' : '' %>>публикуется</option>
                </select>
                <%
                /* Почему игрок скрыт — видно сразу: согласия не было вовсе или
                   оно отозвано. Иначе секретарь будет гадать по флагу. */
                %>
                <span class="muted consent-note">
                  <% if (p.consent.distribution === 'granted') { %>согласие есть
                  <% } else if (p.consent.distribution === 'revoked') { %>согласие отозвано
                  <% } else { %>согласия нет<% } %>
                  <% if (p.proof && p.proof.basis) { %>
                    · <%= p.proof.basis %><%= p.proof.document_date ? ' от ' + p.proof.document_date : '' %>
                  <% } %>
                </span>
                <%
                /* Поля основания нужны, только когда публикацию ВКЛЮЧАЮТ.
                   Пустыми они безвредны: при «скрыт» сервер их не читает. */
                %>
                <input form="edit-player-<%= p.id %>" name="consent_basis" maxlength="200"
                       class="consent-proof" placeholder="основание публикации"
                       value="<%= p.proof && p.proof.basis ? p.proof.basis : '' %>">
                <input form="edit-player-<%= p.id %>" name="consent_document_date"
                       class="consent-proof" placeholder="ГГГГ-ММ-ДД"
                       value="<%= p.proof && p.proof.document_date ? p.proof.document_date : '' %>">
              </td>
              <td class="inline-form">
                <button class="btn btn--secondary btn--small" type="submit" form="edit-player-<%= p.id %>">Сохранить</button>
                <button class="btn btn--danger btn--small" type="submit" form="del-player-<%= p.id %>">Удалить</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% players.forEach(function (p) { %>
      <form id="edit-player-<%= p.id %>" method="post" action="/admin/players/<%= p.id %>/update" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
      <form id="del-player-<%= p.id %>" method="post" action="/admin/players/<%= p.id %>/delete" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
    <% }); %>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
