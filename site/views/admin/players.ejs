<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="top" class="admin-shell">
<div class="container stack">
  <h1>Игроки</h1>
  <%- include('_shell') %>

  <div class="panel">
    <h2>Добавить игрока</h2>
    <form method="post" action="/admin/players" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field-row">
        <div class="field"><label for="p-last">Фамилия</label><input id="p-last" name="last_name" maxlength="60" required></div>
        <div class="field"><label for="p-first">Имя</label><input id="p-first" name="first_name" maxlength="60" required></div>
        <div class="field"><label for="p-middle">Отчество</label><input id="p-middle" name="middle_name" maxlength="60"></div>
      </div>
      <div class="field"><label for="p-city">Город</label><input id="p-city" name="city" maxlength="80" required></div>
      <div class="field"><label for="p-rni">РНИ</label><input id="p-rni" name="rni" maxlength="32" pattern="[0-9A-Za-z-]+" placeholder="номер в РТТ, если есть"></div>
      <div class="field"><label for="p-sex">Пол</label>
        <select id="p-sex" name="sex" required>
          <% sexes.forEach(function (s) { %><option value="<%= s %>"><%= s === 'M' ? 'муж.' : 'жен.' %></option><% }); %>
        </select>
      </div>
      <div class="field"><label for="p-birth">Дата рождения</label>
        <input id="p-birth" name="birth_date" type="date" aria-describedby="p-birth-hint">
      </div>
      <button class="btn btn--primary" type="submit">Добавить</button>
    </form>
    <p class="muted">
      Дата рождения нужна для одного: за участника младше 18 лет согласие даёт
      законный представитель (ч. 1 ст. 9 152-ФЗ), и по ней же снимается гейт в 18.
      Она видна ТОЛЬКО здесь, в административной части: в рейтинг, на витрину и в
      кабинет игрока не выводится. Пустое поле при сохранении означает «не менять».
    </p>
    <p class="muted">
      Результаты соревнований публикуются по факту участия (п. 5 ч. 1 ст. 6 152-ФЗ) —
      отдельного согласия и «основания публикации» у карточки нет. Согласие по ст. 10.1
      касается только фотографии: её игрок (или представитель) загружает в кабинете сам,
      удаление фото — отзыв. Колонка «Фото» показывает состояние этого согласия.
    </p>
  </div>

  <div class="panel">
    <h2>Список (<%= players.length %>)</h2>
    <p class="muted">Поля редактируются прямо в строке — измените и нажмите «Сохранить».</p>
    <%
    /* Формы объявлены ВНЕ таблицы, а поля связаны с ними атрибутом form=
       (вложенные <form> в HTML запрещены, а строка таблицы должна нести
       и сохранение, и удаление). */
    %>
    <div class="table-scroll">
      <table class="admin-table admin-table--edit">
        <thead><tr><th>ID</th><th>ФИО</th><th>Город</th><th>РНИ</th><th>Пол</th><th>Дата рождения</th><th>Фото</th><th>Представитель</th><th>Действия</th></tr></thead>
        <tbody>
          <% players.forEach(function (p) { %>
            <tr>
              <td><%= p.id %></td>
              <td class="name-cell">
                <input form="edit-player-<%= p.id %>" name="last_name" value="<%= p.nameParts.last %>" maxlength="60" required placeholder="Фамилия" aria-label="Фамилия">
                <input form="edit-player-<%= p.id %>" name="first_name" value="<%= p.nameParts.first %>" maxlength="60" required placeholder="Имя" aria-label="Имя">
                <input form="edit-player-<%= p.id %>" name="middle_name" value="<%= p.nameParts.middle %>" maxlength="60" placeholder="Отчество" aria-label="Отчество">
              </td>
              <td><input form="edit-player-<%= p.id %>" name="city" value="<%= p.city %>" maxlength="80" required></td>
              <td><input form="edit-player-<%= p.id %>" name="rni" value="<%= p.rni || '' %>" maxlength="32" pattern="[0-9A-Za-z-]+" size="8"></td>
              <td>
                <select form="edit-player-<%= p.id %>" name="sex" required>
                  <% sexes.forEach(function (s) { %>
                    <option value="<%= s %>"<%= p.sex === s ? ' selected' : '' %>><%= s === 'M' ? 'муж.' : 'жен.' %></option>
                  <% }); %>
                </select>
              </td>
              <%
              /* ДАТА РОЖДЕНИЯ — только здесь, за логином секретаря. Нужна, чтобы
                 проверить возраст и разобрать спорную заявку; правится, потому
                 что опечатка в ней делает взрослого ребёнком и наоборот.
                 В рейтинг, витрину и кабинет игрока она не выводится НИГДЕ —
                 там только возрастная группа (см. приёмку, раздел 18). */
              %>
              <td>
                <input form="edit-player-<%= p.id %>" name="birth_date" type="date"
                       value="<%= p.birth_date || '' %>" class="birth-input">
                <% if (p.minor) { %>
                  <span class="muted consent-note">несовершеннолетний</span>
                <% } else if (!p.birth_date) { %>
                  <span class="muted consent-note">не указана</span>
                <% } %>
              </td>
              <td>
                <%
                /* Состояние согласия на ФОТО (ст. 10.1) — читается из журнала:
                   загружено в кабинете = согласие есть, удалено = отозвано. */
                %>
                <span class="muted consent-note">
                  <% if (p.photo_upload_id) { %>загружено · согласие есть
                  <% } else if (p.consent.distribution === 'revoked') { %>нет · согласие отозвано
                  <% } else { %>нет<% } %>
                </span>
              </td>
              <%
              /* ЗАКОННЫЙ ПРЕДСТАВИТЕЛЬ. Показывается только там, где он по
                 смыслу возможен: у несовершеннолетнего участника. Для
                 совершеннолетних колонка пуста — не «пустая форма на всякий
                 случай», а отсутствие самого понятия. */
              %>
              <td class="guardian-cell">
                <% if (p.minor) { %>
                  <% if (p.guardian) { %>
                    <span class="muted">
                      <%= p.guardian.full_name %> (<%= p.guardian.relation %>)<br>
                      <%= p.guardian.email %>
                    </span>
                  <% } else { %>
                    <span class="muted">не назначен</span>
                  <% } %>
                  <details>
                    <summary><%= p.guardian ? 'Заменить' : 'Назначить' %></summary>
                    <form method="post" action="/admin/players/<%= p.id %>/guardian" class="stacked-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="field">
                        <label for="g-last-<%= p.id %>">Фамилия</label>
                        <input id="g-last-<%= p.id %>" name="guardian_last_name" maxlength="60" required>
                      </div>
                      <div class="field">
                        <label for="g-first-<%= p.id %>">Имя</label>
                        <input id="g-first-<%= p.id %>" name="guardian_first_name" maxlength="60" required>
                      </div>
                      <div class="field">
                        <label for="g-middle-<%= p.id %>">Отчество</label>
                        <input id="g-middle-<%= p.id %>" name="guardian_middle_name" maxlength="60">
                      </div>
                      <div class="field">
                        <label for="g-rel-<%= p.id %>">Кем приходится</label>
                        <input id="g-rel-<%= p.id %>" name="guardian_relation" maxlength="60" required
                               placeholder="мать, отец, опекун">
                      </div>
                      <div class="field">
                        <label for="g-mail-<%= p.id %>">Почта представителя</label>
                        <input id="g-mail-<%= p.id %>" name="guardian_email" type="email" maxlength="160" required>
                      </div>
                      <div class="field">
                        <label for="g-basis-<%= p.id %>">Документ, подтверждающий полномочия</label>
                        <input id="g-basis-<%= p.id %>" name="guardian_basis" maxlength="200" required
                               placeholder="свидетельство о рождении, решение суда, акт опеки">
                      </div>
                      <div class="field">
                        <label for="g-date-<%= p.id %>">Дата документа</label>
                        <input id="g-date-<%= p.id %>" name="guardian_document_date" placeholder="ГГГГ-ММ-ДД" required>
                      </div>
                      <button class="btn btn--secondary btn--small" type="submit">Сохранить представителя</button>
                    </form>
                    <% if (p.guardianHistory && p.guardianHistory.length > 1) { %>
                      <p class="muted">Прежние представители:</p>
                      <ul class="log-list">
                        <% p.guardianHistory.filter(function (h) { return h.revoked_at; }).forEach(function (h) { %>
                          <li><%= h.full_name %> (<%= h.relation %>) — снят <%= h.revoked_at %></li>
                        <% }); %>
                      </ul>
                    <% } %>
                  </details>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
              <td class="inline-form">
                <button class="btn btn--secondary btn--small" type="submit" form="edit-player-<%= p.id %>">Сохранить</button>
                <button class="btn btn--danger btn--small" type="submit" form="del-player-<%= p.id %>">Удалить</button>
                <% if (p.photo_upload_id) { %>
                  <button class="btn btn--secondary btn--small" type="submit" form="photo-player-<%= p.id %>">Убрать фото</button>
                <% } %>
                <% if (p.account) { %>
                  <button class="btn btn--secondary btn--small" type="submit" form="link-player-<%= p.id %>" title="Ссылка для входа в кабинет — когда письмо не доходит">Ссылка в кабинет</button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% players.forEach(function (p) { %>
      <form id="edit-player-<%= p.id %>" method="post" action="/admin/players/<%= p.id %>/update" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
      <form id="del-player-<%= p.id %>" method="post" action="/admin/players/<%= p.id %>/delete" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
      <form id="link-player-<%= p.id %>" method="post" action="/admin/players/<%= p.id %>/cabinet-link" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
      <form id="photo-player-<%= p.id %>" method="post" action="/admin/players/<%= p.id %>/photo/delete" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
    <% }); %>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
