<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="top" class="admin-shell">
<div class="container stack">
  <h1>Турниры</h1>
  <%- include('_shell') %>

  <div class="panel">
    <h2>Добавить турнир</h2>
    <form method="post" action="/admin/tournaments" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="t-name">Название</label><input id="t-name" name="name" maxlength="160" required></div>
      <div class="field"><label for="t-date">Дата завершения</label><input id="t-date" name="end_date" placeholder="ГГГГ-ММ-ДД" maxlength="10" required></div>
      <div class="field"><label for="t-cat">Категория</label>
        <select id="t-cat" name="category" required>
          <% categories.forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }); %>
        </select>
      </div>
      <button class="btn btn--primary" type="submit">Добавить</button>
    </form>
    <p class="muted">Категория A — чемпионаты и первенства области (коэффициент ×2), B — остальные (×1).</p>
  </div>

  <div class="panel">
    <h2>Список (<%= tournaments.length %>)</h2>
    <p class="muted">Поля редактируются прямо в строке — измените и нажмите «Сохранить».</p>
    <%
    /* Формы объявлены ВНЕ таблицы, поля связаны с ними атрибутом form=:
       вложенные <form> в HTML запрещены. */
    %>
    <div class="table-scroll">
      <table class="admin-table admin-table--edit">
        <thead><tr><th>ID</th><th>Название</th><th>Завершение</th><th>Кат.</th><th>Записей</th><th>Действия</th></tr></thead>
        <tbody>
          <% tournaments.forEach(function (t) { %>
            <tr>
              <td><a href="/tournaments/<%= t.id %>"><%= t.id %></a></td>
              <td><input form="edit-tournament-<%= t.id %>" name="name" value="<%= t.name %>" maxlength="160" required></td>
              <td><input form="edit-tournament-<%= t.id %>" name="end_date" value="<%= t.end_date %>" maxlength="10" required></td>
              <td>
                <select form="edit-tournament-<%= t.id %>" name="category" required>
                  <% categories.forEach(function (c) { %>
                    <option value="<%= c %>"<%= t.category === c ? ' selected' : '' %>><%= c %></option>
                  <% }); %>
                </select>
              </td>
              <td><%= t.entries %></td>
              <td class="inline-form">
                <a class="btn btn--secondary btn--small" href="/admin/tournaments/<%= t.id %>/results">Результаты</a>
                <button class="btn btn--secondary btn--small" type="submit" form="edit-tournament-<%= t.id %>">Сохранить</button>
                <button class="btn btn--danger btn--small" type="submit" form="del-tournament-<%= t.id %>">Удалить</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% tournaments.forEach(function (t) { %>
      <form id="edit-tournament-<%= t.id %>" method="post" action="/admin/tournaments/<%= t.id %>/update" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
      <form id="del-tournament-<%= t.id %>" method="post" action="/admin/tournaments/<%= t.id %>/delete" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
    <% }); %>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
