<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="top" class="admin-shell">
<div class="container stack">
  <h1>Турниры</h1>
  <%- include('_shell') %>

  <div class="panel">
    <h2>Добавить турнир</h2>
    <%
    /* Порядок полей и кнопки — решение владельца 06.09.2026: название → начало → завершение →
       категория → город → тип → возраст; «Сохранить черновик» (виден только здесь) и
       «Опубликовать» (в календарь и на сайт). Возраст — список + «ввод вручную». */
    %>
    <form method="post" action="/admin/tournaments" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field field--wide"><label for="t-name">Название</label><input id="t-name" name="name" maxlength="160" required></div>
      <div class="field"><label for="t-start">Начало</label><input id="t-start" name="start_date" placeholder="ГГГГ-ММ-ДД" maxlength="10"></div>
      <div class="field"><label for="t-date">Завершение</label><input id="t-date" name="end_date" placeholder="ГГГГ-ММ-ДД" maxlength="10" required></div>
      <div class="field"><label for="t-cat">Категория</label>
        <select id="t-cat" name="category" required>
          <% categories.forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }); %>
        </select>
      </div>
      <div class="field"><label for="t-city">Город</label><input id="t-city" name="city" maxlength="80"></div>
      <div class="field"><label for="t-kind">Тип</label>
        <select id="t-kind" name="kind">
          <% Object.keys(kindRu).forEach(function (k) { %><option value="<%= k %>"<%= k === 'other' ? ' selected' : '' %>><%= kindRu[k] %></option><% }); %>
        </select>
      </div>
      <div class="field"><label for="t-sex">Пол</label>
        <select id="t-sex" name="sex">
          <option value="">—</option>
          <% Object.keys(sexRu).forEach(function (k) { %><option value="<%= k %>"><%= sexRu[k] %></option><% }); %>
        </select>
      </div>
      <div class="field"><label for="t-age">Возраст</label>
        <select id="t-age" name="age_group" data-age-select>
          <option value="">—</option>
          <% ages.forEach(function (a) { %><option value="<%= a %>"><%= a %></option><% }); %>
          <option value="custom">ввод вручную</option>
        </select>
      </div>
      <div class="field" data-age-custom hidden><label for="t-age-custom">Возраст вручную</label><input id="t-age-custom" name="age_group_custom" maxlength="40" placeholder="напр. 35–44"></div>
      <div class="field">
        <button class="btn btn--secondary" type="submit" name="action" value="draft">Сохранить черновик</button>
      </div>
      <div class="field">
        <button class="btn btn--primary" type="submit" name="action" value="publish">Опубликовать</button>
      </div>
    </form>
    <p class="muted">Категория A — чемпионаты и первенства области (коэффициент ×2), B — остальные (×1).
      Город, дата начала, тип и возраст — для фильтров календаря на сайте (ТЗ п. 4.3); статус
      «предстоящий / идёт / завершён» считается от дат сам.</p>
  </div>

  <div class="panel">
    <h2>Список (<%= tournaments.length %>)</h2>
    <p class="muted">Черновик виден только здесь; «Опубликовать» показывает турнир в календаре и на сайте (и включает его результаты в рейтинг). «Редактировать» открывает поля строки.</p>
    <%
    /* Формы объявлены ВНЕ таблицы, поля связаны с ними атрибутом form=:
       вложенные <form> в HTML запрещены. */
    %>
    <div class="table-scroll">
      <table class="admin-table admin-table--edit">
        <thead><tr><th>ID</th><th>Статус</th><th>Название</th><th>Начало</th><th>Завершение</th><th>Кат.</th><th>Город</th><th>Тип</th><th>Пол</th><th>Возраст</th><th>Записей</th><th>Действия</th></tr></thead>
        <tbody>
          <% tournaments.forEach(function (t) { %>
            <tr class="t-row" data-editable>
              <td><a href="/tournaments/<%= t.id %>"><%= t.id %></a></td>
              <td><span class="tag <%= t.is_published ? 'tag--upcoming' : '' %>"><%= t.is_published ? 'опубликован' : 'черновик' %></span></td>
              <td><span class="ro"><%= t.name %></span><input class="ed" form="edit-tournament-<%= t.id %>" name="name" value="<%= t.name %>" maxlength="160" required></td>
              <td><span class="ro"><%= t.start_date || '—' %></span><input class="ed" form="edit-tournament-<%= t.id %>" name="start_date" value="<%= t.start_date || '' %>" maxlength="10" placeholder="ГГГГ-ММ-ДД"></td>
              <td><span class="ro"><%= t.end_date %></span><input class="ed" form="edit-tournament-<%= t.id %>" name="end_date" value="<%= t.end_date %>" maxlength="10" required></td>
              <td><span class="ro"><%= t.category %></span>
                <select class="ed" form="edit-tournament-<%= t.id %>" name="category" required>
                  <% categories.forEach(function (c) { %><option value="<%= c %>"<%= t.category === c ? ' selected' : '' %>><%= c %></option><% }); %>
                </select>
              </td>
              <td><span class="ro"><%= t.city || '—' %></span><input class="ed" form="edit-tournament-<%= t.id %>" name="city" value="<%= t.city || '' %>" maxlength="80"></td>
              <td><span class="ro"><%= kindRu[t.kind] || '—' %></span>
                <select class="ed" form="edit-tournament-<%= t.id %>" name="kind">
                  <% Object.keys(kindRu).forEach(function (k) { %><option value="<%= k %>"<%= t.kind === k ? ' selected' : '' %>><%= kindRu[k] %></option><% }); %>
                </select>
              </td>
              <td><span class="ro"><%= t.sex ? sexRu[t.sex] : '—' %></span>
                <select class="ed" form="edit-tournament-<%= t.id %>" name="sex">
                  <option value=""<%= !t.sex ? ' selected' : '' %>>—</option>
                  <% Object.keys(sexRu).forEach(function (k) { %><option value="<%= k %>"<%= t.sex === k ? ' selected' : '' %>><%= sexRu[k] %></option><% }); %>
                </select>
              </td>
              <td><span class="ro"><%= t.age_group || '—' %></span>
                <% const known = !t.age_group || ages.includes(t.age_group); %>
                <select class="ed" form="edit-tournament-<%= t.id %>" name="age_group" data-age-select>
                  <option value=""<%= !t.age_group ? ' selected' : '' %>>—</option>
                  <% ages.forEach(function (a) { %><option value="<%= a %>"<%= t.age_group === a ? ' selected' : '' %>><%= a %></option><% }); %>
                  <option value="custom"<%= !known ? ' selected' : '' %>>ввод вручную</option>
                </select>
                <input class="ed" form="edit-tournament-<%= t.id %>" name="age_group_custom" value="<%= known ? '' : t.age_group %>" maxlength="40" placeholder="вручную" data-age-custom<%= known ? ' hidden' : '' %>>
              </td>
              <td><%= t.entries %></td>
              <td class="inline-form">
                <a class="btn btn--secondary btn--small" href="/admin/tournaments/<%= t.id %>/results">Результаты</a>
                <button class="btn btn--secondary btn--small ro" type="button" data-edit>Редактировать</button>
                <button class="btn btn--primary btn--small ed" type="submit" form="edit-tournament-<%= t.id %>">Сохранить</button>
                <button class="btn btn--<%= t.is_published ? 'secondary' : 'primary' %> btn--small" type="submit" form="pub-tournament-<%= t.id %>"><%= t.is_published ? 'Снять с публикации' : 'Опубликовать' %></button>
                <button class="btn btn--danger btn--small" type="submit" form="del-tournament-<%= t.id %>" data-confirm="Удалить турнир «<%= t.name %>» со всеми результатами, матчами и сетками?">Удалить</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% tournaments.forEach(function (t) { %>
      <form id="edit-tournament-<%= t.id %>" method="post" action="/admin/tournaments/<%= t.id %>/update" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
      <form id="pub-tournament-<%= t.id %>" method="post" action="/admin/tournaments/<%= t.id %>/publish" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="value" value="<%= t.is_published ? '0' : '1' %>">
      </form>
      <form id="del-tournament-<%= t.id %>" method="post" action="/admin/tournaments/<%= t.id %>/delete" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
    <% }); %>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
