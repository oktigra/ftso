<%
/* Админ-страницы — временная простая вёрстка на общих токенах.
   Их дизайн — отдельным шагом. */
%>
<div class="admin-bar">
  <a href="/admin"<%= currentPath === '/admin' ? ' aria-current="page"' : '' %>>Сводка</a>
  <% if (sections.includes('players')) { %>
  <a href="/admin/players"<%= currentPath === '/admin/players' ? ' aria-current="page"' : '' %>>Игроки</a>
  <a href="/admin/registrations"<%= currentPath.indexOf('/admin/registrations') === 0 ? ' aria-current="page"' : '' %>>Заявки<%= typeof pendingCount !== 'undefined' && pendingCount ? ` (${pendingCount})` : '' %></a>
  <a href="/admin/tournaments"<%= currentPath === '/admin/tournaments' ? ' aria-current="page"' : '' %>>Турниры</a>
  <a href="/admin/tournament-requests"<%= currentPath.indexOf('/admin/tournament-requests') === 0 ? ' aria-current="page"' : '' %>>Заявки на турниры<%= typeof pendingTournamentCount !== 'undefined' && pendingTournamentCount ? ` (${pendingTournamentCount})` : '' %></a>
  <% } %>
  <% if (sections.includes('news')) { %><a href="/admin/news"<%= currentPath.indexOf('/admin/news') === 0 ? ' aria-current="page"' : '' %>>Новости</a><% } %>
  <% if (sections.includes('directories')) { %><a href="/admin/directories/coaches"<%= currentPath.indexOf('/admin/directories') === 0 ? ' aria-current="page"' : '' %>>Справочники</a><% } %>
  <% if (sections.includes('library')) { %><a href="/admin/texts"<%= currentPath === '/admin/texts' ? ' aria-current="page"' : '' %>>Тексты</a><% } %>
  <% if (sections.includes('library')) { %><a href="/admin/seo"<%= currentPath === '/admin/seo' ? ' aria-current="page"' : '' %>>SEO</a><% } %>
  <% if (sections.includes('library')) { %><a href="/admin/library"<%= currentPath.indexOf('/admin/library') === 0 ? ' aria-current="page"' : '' %>>Документы и галерея</a><% } %>
  <% if (sections.includes('feedback')) { %><a href="/admin/feedback"<%= currentPath.indexOf('/admin/feedback') === 0 ? ' aria-current="page"' : '' %>>Обращения</a><% } %>
  <a href="/admin/guide"<%= currentPath === '/admin/guide' ? ' aria-current="page"' : '' %>>Инструкция</a>
  <a href="/admin/account"<%= currentPath === '/admin/account' ? ' aria-current="page"' : '' %>>Мой аккаунт</a>
  <% if (sections.includes('vault')) { %>
    <a href="/admin/vault"<%= currentPath.indexOf('/admin/vault') === 0 ? ' aria-current="page"' : '' %>>Закрытые документы</a>
    <a href="/admin/users"<%= currentPath === '/admin/users' ? ' aria-current="page"' : '' %>>Пользователи</a>
  <% } %>
  <form method="post" action="/logout">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn--secondary btn--small" type="submit">Выйти (<%= user.username %> · <%= user.role %>)</button>
  </form>
</div>
<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash flash--<%= flash.kind %>"><%= flash.text %></div>
  <% if (flash.secret) { %>
    <div class="flash-secret" role="status">
      <code class="flash-secret__value"><%= flash.secret %></code>
      <button type="button" class="btn btn--primary btn--small" data-copy="<%= flash.secret %>">Скопировать</button>
      <span class="muted">Показывается один раз — после ухода со страницы не восстановить.</span>
    </div>
  <% } %>
<% } %>
