<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="top" class="admin-shell">
<div class="container stack">
  <h1><%= tournament.name %></h1>
  <%- include('_shell') %>
  <p class="muted">Завершение <%= tournament.end_date %> · категория <%= tournament.category %> · потолок участников <%= maxParticipants %>.</p>

  <div class="panel">
    <h2>Добавить результат</h2>
    <%
    /* УСКОРЕНИЕ ВВОДА (05.09.2026): игрок — поле с подсказкой по первым буквам
       (datalist), а не список на сотни фамилий. Если игрока в базе нет —
       заполняются три поля ниже, и он заводится этим же нажатием. */
    %>
    <datalist id="players-list">
      <% players.forEach(function (p) { %><option value="<%= p.full_name %> (<%= p.city %>)"></option><% }); %>
    </datalist>
    <form method="post" action="/admin/tournaments/<%= tournament.id %>/results" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field field--wide"><label for="r-player">Игрок</label>
        <input id="r-player" name="player" list="players-list" autocomplete="off" required maxlength="140"
               placeholder="первые буквы фамилии" value="<%= typeof form !== 'undefined' && form.player ? form.player : '' %>">
      </div>
      <div class="field"><label for="r-place">Место</label><input id="r-place" name="place" inputmode="numeric" required></div>
      <button class="btn btn--primary" type="submit">Добавить</button>
      <details class="field new-player">
        <summary>Игрока нет в базе — завести здесь</summary>
        <div class="inline-form">
          <div class="field"><label for="r-new-city">Город</label><input id="r-new-city" name="new_city" maxlength="80"></div>
          <div class="field"><label for="r-new-sex">Пол</label>
            <select id="r-new-sex" name="new_sex"><option value="">—</option><option value="M">муж.</option><option value="F">жен.</option></select>
          </div>
          <div class="field"><label for="r-new-birth">Дата рождения</label><input id="r-new-birth" name="new_birth_date" placeholder="ГГГГ-ММ-ДД" maxlength="10"></div>
        </div>
        <p class="muted">ФИО берётся из поля «Игрок» (Фамилия Имя Отчество). Дубли по ФИО + дате рождения не заводятся.</p>
      </details>
    </form>
  </div>

  <div class="panel" id="groups">
    <h2>Круговые группы</h2>
    <%
    /* СЕТКА, СЛОЙ 1: группа «каждый с каждым». Клетка = счёт с точки зрения игрока
       СТРОКИ («6:3 3:6 10:8»; «wo» — выиграл без игры, «-wo» — проиграл). Победитель
       считается по сетам, места — по победам → личная встреча → сеты → геймы. */
    %>
    <form method="post" action="/admin/tournaments/<%= tournament.id %>/groups" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="g-name">Новая группа</label><input id="g-name" name="name" maxlength="40" placeholder="A" required></div>
      <div class="field"><label for="g-kind">Разряд</label>
        <select id="g-kind" name="kind"><option value="single">одиночный</option><option value="double">парный</option></select></div>
      <button class="btn btn--secondary btn--small" type="submit">Создать группу</button>
    </form>
    <% groups.forEach(function (g) { %>
      <div class="group-block">
        <h3>Группа <%= g.name %> <span class="muted">(<%= g.kind === 'double' ? 'парный' : 'одиночный' %>, сыграно <%= g.playedTotal %> из <%= g.total %>)</span></h3>
        <form method="post" action="/admin/tournaments/<%= tournament.id %>/groups/<%= g.id %>/members" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field field--wide"><label for="gm-<%= g.id %>">Добавить участника</label>
            <input id="gm-<%= g.id %>" name="player" list="players-list" autocomplete="off" maxlength="140" placeholder="первые буквы фамилии" required></div>
          <button class="btn btn--secondary btn--small" type="submit">Добавить</button>
        </form>
        <% if (g.members.length) { %>
          <div class="table-scroll">
            <table class="admin-table group-table">
              <thead><tr><th>#</th><th>Игрок</th><% g.members.forEach(function (c, j) { %><th><%= j + 1 %></th><% }); %><th>Поб.</th><th>Место</th><th></th></tr></thead>
              <tbody>
                <% g.members.forEach(function (r, i) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td class="player"><%= r.full_name %></td>
                    <% g.members.forEach(function (c, j) { %>
                      <% if (r.id === c.id) { %><td class="group-self">—</td><% } else { const cell = g.cells[r.id + ':' + c.id]; %>
                        <td class="group-cell<%= cell ? (cell.won ? ' group-win' : ' group-loss') : '' %>">
                          <form method="post" action="/admin/tournaments/<%= tournament.id %>/groups/<%= g.id %>/cell" class="cell-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="a" value="<%= r.id %>"><input type="hidden" name="b" value="<%= c.id %>">
                            <input name="score" value="<%= cell ? (cell.won ? cell.score : (cell.score === 'w/o' ? '-wo' : cell.score.split(' ').map(function (s) { var m = /^(\d+)[:\-](\d+)(\(\d+\))?$/.exec(s); return m ? m[2] + ':' + m[1] + (m[3] || '') : s; }).join(' '))) : '' %>" maxlength="60" placeholder="6:3 6:4" aria-label="Счёт <%= r.full_name %> — <%= c.full_name %>">
                          </form>
                        </td>
                      <% } %>
                    <% }); %>
                    <td><%= g.stats[r.id].wins %></td>
                    <td><strong><%= g.stats[r.id].played ? g.stats[r.id].place : '—' %></strong></td>
                    <td><form method="post" action="/admin/tournaments/<%= tournament.id %>/groups/<%= g.id %>/members/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--danger btn--small" type="submit" data-confirm="Убрать <%= r.full_name %> из группы?">Убрать</button></form></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <p class="muted">Счёт вводится с точки зрения игрока в строке: «6:3 6:4», «6:3 3:6 10:8», «wo» — выиграл без игры, «-wo» — проиграл без игры. Enter в клетке сохраняет. Пустая клетка — матч удалён.</p>
          <div class="inline-form">
            <form method="post" action="/admin/tournaments/<%= tournament.id %>/groups/<%= g.id %>/places">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--primary btn--small" type="submit"<%= g.complete ? '' : ' disabled title="Сыграны не все матчи"' %>>Записать места в результаты</button>
            </form>
            <form method="post" action="/admin/tournaments/<%= tournament.id %>/groups/<%= g.id %>/delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--danger btn--small" type="submit" data-confirm="Удалить группу «<%= g.name %>»? Сыгранные матчи останутся.">Удалить группу</button>
            </form>
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>

  <div class="panel" id="brackets">
    <h2>Олимпийка (сетка на выбывание)</h2>
    <%
    /* СЕТКА, СЛОЙ 2. Раунды столбцами; в паре — счёт с точки зрения ВЕРХНЕГО игрока
       («6:3 6:4», «wo», «-wo») или «bye», если второго нет. Отмена снимает и всё дальше. */
    %>
    <form method="post" action="/admin/tournaments/<%= tournament.id %>/brackets" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="b-name">Новая сетка</label><input id="b-name" name="name" maxlength="40" placeholder="Основная" required></div>
      <div class="field"><label for="b-size">Размер</label>
        <select id="b-size" name="size"><% bracketSizes.forEach(function (n) { %><option value="<%= n %>"<%= n === 8 ? ' selected' : '' %>><%= n %></option><% }); %></select></div>
      <div class="field"><label for="b-kind">Разряд</label>
        <select id="b-kind" name="kind"><option value="single">одиночный</option><option value="double">парный</option></select></div>
      <button class="btn btn--secondary btn--small" type="submit">Создать сетку</button>
    </form>
    <% brackets.forEach(function (b) { %>
      <div class="group-block">
        <h3>Сетка «<%= b.name %>» на <%= b.size %> <span class="muted">(<%= b.kind === 'double' ? 'парный' : 'одиночный' %>, посеяно <%= b.filled %> из <%= b.size %><%= b.champion ? ', победитель: ' + b.champion.full_name : '' %>)</span></h3>
        <form method="post" action="/admin/tournaments/<%= tournament.id %>/brackets/<%= b.id %>/seed" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="bp-<%= b.id %>">Позиция</label><input id="bp-<%= b.id %>" name="position" inputmode="numeric" maxlength="2" placeholder="1–<%= b.size %>" required></div>
          <div class="field field--wide"><label for="bs-<%= b.id %>">Игрок</label>
            <input id="bs-<%= b.id %>" name="player" list="players-list" autocomplete="off" maxlength="140" placeholder="первые буквы фамилии" required></div>
          <button class="btn btn--secondary btn--small" type="submit">Посеять</button>
        </form>
        <div class="bracket">
          <% b.rounds.forEach(function (round) { %>
            <div class="bracket__round">
              <div class="bracket__title"><%= round.name %></div>
              <% round.pairs.forEach(function (p) { %>
                <div class="bracket__pair<%= p.winner ? ' bracket__pair--done' : '' %>">
                  <div class="bracket__slot<%= p.winner && p.winner === p.aId ? ' bracket__slot--win' : '' %>">
                    <%= p.a ? p.a.full_name : '—' %>
                    <% if (round.r === 0 && p.aId && !p.winner) { %><form method="post" action="/admin/tournaments/<%= tournament.id %>/brackets/<%= b.id %>/unseed" class="bracket__x"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="position" value="<%= 2 * p.k + 1 %>"><button type="submit" class="link-x" aria-label="Убрать">×</button></form><% } %>
                  </div>
                  <div class="bracket__slot<%= p.winner && p.winner === p.bId ? ' bracket__slot--win' : '' %>">
                    <%= p.b ? p.b.full_name : '—' %>
                    <% if (round.r === 0 && p.bId && !p.winner) { %><form method="post" action="/admin/tournaments/<%= tournament.id %>/brackets/<%= b.id %>/unseed" class="bracket__x"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="position" value="<%= 2 * p.k + 2 %>"><button type="submit" class="link-x" aria-label="Убрать">×</button></form><% } %>
                  </div>
                  <% if (p.winner) { %>
                    <div class="bracket__score"><%= p.bye ? 'без игры' : (p.score || 'итог записан') %>
                      <form method="post" action="/admin/tournaments/<%= tournament.id %>/brackets/<%= b.id %>/undo" class="bracket__x"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="r" value="<%= round.r %>"><input type="hidden" name="k" value="<%= p.k %>"><button type="submit" class="btn btn--danger btn--small" data-confirm="Отменить итог пары? Снимется и всё, куда прошёл победитель.">отменить</button></form>
                    </div>
                  <% } else if (p.aId || p.bId) { %>
                    <form method="post" action="/admin/tournaments/<%= tournament.id %>/brackets/<%= b.id %>/decide" class="bracket__form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="r" value="<%= round.r %>"><input type="hidden" name="k" value="<%= p.k %>">
                      <input name="score" maxlength="60" placeholder="<%= p.aId && p.bId ? '6:3 6:4' : 'bye' %>" aria-label="Итог пары">
                      <button class="btn btn--secondary btn--small" type="submit">Ок</button>
                    </form>
                  <% } %>
                </div>
              <% }); %>
            </div>
          <% }); %>
          <div class="bracket__round"><div class="bracket__title">Победитель</div><div class="bracket__pair"><div class="bracket__slot bracket__slot--win"><%= b.champion ? b.champion.full_name : '—' %></div></div></div>
        </div>
        <p class="muted">Счёт — с точки зрения верхнего игрока пары; «wo»/«-wo» — без игры; «bye» — если второго нет. Места: 1, 2, 3 (полуфиналисты), 5 (четвертьфиналисты), 9, 17.</p>
        <div class="inline-form">
          <form method="post" action="/admin/tournaments/<%= tournament.id %>/brackets/<%= b.id %>/places">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--primary btn--small" type="submit"<%= b.championId ? '' : ' disabled title="Финал не сыгран"' %>>Записать места в результаты</button>
          </form>
          <form method="post" action="/admin/tournaments/<%= tournament.id %>/brackets/<%= b.id %>/delete">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--danger btn--small" type="submit" data-confirm="Удалить сетку «<%= b.name %>»? Сыгранные матчи останутся.">Удалить сетку</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="panel">
    <h2>Массовый ввод из протокола</h2>
    <%
    /* Одно поле — весь протокол. Сначала «Проверить»: каждая строка сверяется с базой
       и подсвечивается; «Сохранить всё» доступно, только когда все строки зелёные. */
    %>
    <form method="post" action="/admin/tournaments/<%= tournament.id %>/results/import" class="inline-form" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="import-file">Или загрузите таблицу (.xlsx / .csv, колонки «Место», «Игрок»)</label>
        <input id="import-file" type="file" name="file" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"></div>
      <button class="btn btn--secondary" type="submit">Прочитать файл</button>
    </form>
    <% if (bulk && bulk.fromFile) { %><p class="muted">Из файла «<%= bulk.fromFile %>» прочитано строк: <%= bulk.rows.length %> — проверьте и сохраните.</p><% } %>
    <form method="post" action="/admin/tournaments/<%= tournament.id %>/results/bulk" class="stacked-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="bulk-text">Место и игрок в каждой строке (или через «;»); несколько игроков на одно место — через запятую</label>
        <textarea id="bulk-text" name="text" rows="8" maxlength="20000" placeholder="1 Иванов Иван Иванович&#10;2 Петров Пётр Петрович&#10;3-4 Сидоров Сидор, Козлов Козьма (Вязьма)&#10;5-8 …"><%= bulk ? bulk.text : '' %></textarea>
      </div>
      <div class="inline-form">
        <button class="btn btn--secondary" type="submit" name="mode" value="preview">Проверить</button>
        <% if (bulk && bulk.ok) { %><button class="btn btn--primary" type="submit" name="mode" value="save">Сохранить всё (<%= bulk.rows.length %>)</button><% } %>
      </div>
    </form>
    <% if (bulk) { %>
      <div class="table-scroll">
        <table class="admin-table bulk-preview">
          <thead><tr><th>Место</th><th>В протоколе</th><th>В базе</th><th>Итог</th></tr></thead>
          <tbody>
            <% bulk.rows.forEach(function (r) { %>
              <tr class="bulk-<%= r.status %>">
                <td><%= r.place === null ? '—' : r.place %></td>
                <td><%= r.name %></td>
                <td><%= r.label || '—' %></td>
                <td><%= ({ ok: 'ок', missing: 'не найден', ambiguous: 'несколько тёзок', dup: 'дубль', unparsed: 'не разобрано' })[r.status] %><%= r.hint ? ' — ' + r.hint : '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="muted"><%= bulk.ok ? 'Все строки сверены — можно сохранять.' : 'Исправьте строки с пометками и нажмите «Проверить» ещё раз.' %></p>
    <% } %>
    <p class="muted">Внесли все результаты турнира — пересчитайте рейтинг, чтобы они попали в таблицу на сайте:</p>
    <form method="post" action="/admin/rating/recompute" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn--secondary btn--small" type="submit">Пересчитать рейтинг</button>
    </form>
  </div>

  <div class="panel">
    <h2>Результаты (<%= results.length %>)</h2>
    <div class="table-scroll">
      <table class="admin-table">
        <thead><tr><th>Место</th><th>Игрок</th><th>Город</th><th>Действия</th></tr></thead>
        <tbody>
          <% results.forEach(function (r) { %>
            <tr>
              <td class="rank"><%= r.place %></td>
              <td class="player"><%= r.full_name %></td>
              <td><%= r.city %></td>
              <td>
                <form method="post" action="/admin/results/<%= r.id %>/delete">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn--danger btn--small" type="submit">Удалить</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel">
    <h2>Матчи (необязательно — для тай-брейка)</h2>
    <form method="post" action="/admin/tournaments/<%= tournament.id %>/matches" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field field--wide"><label for="m-win">Победитель</label>
        <input id="m-win" name="winner" list="players-list" autocomplete="off" required maxlength="140" placeholder="первые буквы фамилии">
      </div>
      <div class="field field--wide"><label for="m-lose">Проигравший</label>
        <input id="m-lose" name="loser" list="players-list" autocomplete="off" required maxlength="140" placeholder="первые буквы фамилии">
      </div>
      <div class="field"><label for="m-score">Счёт</label>
        <input id="m-score" name="score" type="text" maxlength="60" placeholder="6:4 3:6 10:8">
      </div>
      <div class="field"><label for="m-date">Дата матча</label>
        <input id="m-date" name="played_on" type="date">
      </div>
      <button class="btn btn--primary" type="submit">Добавить матч</button>
    </form>
    <p class="muted">Обратный матч (тот же турнир, победитель и проигравший поменялись местами) — отдельная запись, это разрешено.</p>
    <div class="table-scroll">
      <table class="admin-table">
        <thead><tr><th>Победитель</th><th>Проигравший</th><th>Счёт</th><th>Дата</th><th>Действия</th></tr></thead>
        <tbody>
          <% matches.forEach(function (m) { %>
            <tr>
              <td class="player"><%= m.winner %></td>
              <td><%= m.loser %></td>
              <td><%= m.score || '—' %></td>
              <td><%= m.played_on || '—' %></td>
              <td>
                <form method="post" action="/admin/matches/<%= m.id %>/delete">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn--danger btn--small" type="submit">Удалить</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
