<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="top" data-page="home">

<section class="hero">
  <svg class="court-watermark" data-parallax=".14" viewBox="0 0 300 400" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <rect x="10" y="10" width="280" height="380" rx="2"/>
    <line x1="10" y1="200" x2="290" y2="200"/>
    <rect x="45" y="70" width="210" height="260"/>
    <line x1="150" y1="70" x2="150" y2="330"/>
    <line x1="45" y1="200" x2="255" y2="200"/>
  </svg>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Официальный сайт Федерации тенниса Смоленской области</span>
      <h1><%= texts.title %></h1>
      <p class="lead"><%= texts.lead %></p>
      <div class="hero-cta">
        <a class="btn btn--primary" href="/tournaments">Найти турнир</a>
        <a class="btn btn--secondary" href="<%= myRatingHref %>">Мой рейтинг</a>
        <a class="btn btn--secondary" href="/coaches">Найти тренера</a>
        <a class="btn btn--secondary" href="/courts">Корты и клубы</a>
      </div>
      <div class="stats">
        <% stats.forEach(function (s) { %>
          <div class="stat fx-card"><%- include('partials/court-card') %><b><%= s.value %></b><span><%= s.label %></span></div>
        <% }); %>
      </div>
    </div>
    <div class="hero-panel" data-parallax=".05">
      <%
      /* Фото — ЛОКАЛЬНАЯ заглушка 4:3, без хотлинков. Реальное фото заказчик
         подставит, когда придёт модуль контента. */
      %>
      <div class="photo">
        <% if (heroUploadId) { %>
          <img class="photo__img" src="/site/hero?v=<%= heroUploadId %>" alt="" width="1200" height="900">
        <% } else { %>
          <div class="ph-stripes"></div>
          <div class="ph-label"><span>фото · теннисный корт / матч · 4:3 · ~1200×900</span></div>
        <% } %>
      </div>
      <div class="info-card fx-card"><%- include('partials/court-card') %>
        <% if (nextEvent) { %>
          <div class="ic-item"><small>Ближайший турнир</small><b><a href="/tournaments/<%= nextEvent.id %>"><%= nextEvent.date %></a></b></div>
          <div class="ic-sep" aria-hidden="true"></div>
          <div class="ic-item"><small>Статус</small><span class="status <%= nextEvent.statusClass %>"><%= nextEvent.status %></span></div>
        <% } else { %>
          <div class="ic-item"><small>Ближайший турнир</small><b>скоро в календаре</b></div>
          <div class="ic-sep" aria-hidden="true"></div>
          <div class="ic-item"><small>Календарь</small><a href="/tournaments">все турниры →</a></div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%
/* Блок турниров — ЖИВЫЕ данные: пять последних из календаря. */
%>
<%- include('partials/partners') %>

<% if (recentMatches.length) { %>
<%
/* ЛЕНТА «СЕГОДНЯ НА КОРТЕ» (по образцу ленты «Текущий счёт» ФТР): матчи сеток за
   сегодня/вчера или идущих турниров. Нет матчей — блока нет. Горизонтальная прокрутка. */
%>
<section class="live-strip" aria-label="Сегодня на корте">
  <div class="container">
    <div class="live-strip__head"><span class="eyebrow">Сегодня на корте</span></div>
    <div class="live-strip__row">
      <% recentMatches.forEach(function (m) { %>
        <article class="live-card">
          <a class="live-card__t" href="/tournaments/<%= m.tournament_id %>"><%= m.tournament %></a>
          <div class="live-card__p live-card__p--win"><% if (m.w_anon) { %>Игрок удалён<% } else { %><a href="/player/<%= m.w_id %>"><%= m.w_name %></a><% } %></div>
          <div class="live-card__p"><% if (m.l_anon) { %>Игрок удалён<% } else { %><a href="/player/<%= m.l_id %>"><%= m.l_name %></a><% } %></div>
          <div class="live-card__s"><%= m.scoreShown || '' %> <span class="muted">· <%= m.played_on %><%= m.kind === 'double' ? ' · пары' : '' %></span></div>
        </article>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section-pad section-wm" id="tournaments">
  <svg class="wm wm--tourn" data-parallax=".1" viewBox="0 0 300 400" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="10" y="10" width="280" height="380" rx="2"/><line x1="10" y1="200" x2="290" y2="200"/><rect x="45" y="70" width="210" height="260"/><line x1="150" y1="70" x2="150" y2="330"/><line x1="45" y1="200" x2="255" y2="200"/></svg>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Календарь сезона</span>
      <h2>Турниры Федерации</h2>
      <p class="lead"><%= texts.tournamentsLead %></p>
    </div>
    <div class="tourn-grid">
      <div>
        <%
        /* КАРТОЧКИ ТУРНИРОВ вместо таблицы: дата крупно, название, город, категория,
           статус; ближайшие/идущие — первыми, затем последние завершённые. */
        const monthsRu = ['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];
        const dm = (d) => d ? `${Number(d.slice(8, 10))} ${monthsRu[Number(d.slice(5, 7)) - 1]}` : '';
        const statusRu = { upcoming: 'предстоящий', ongoing: 'идёт', finished: 'завершён' };
        %>
        <% if (!homeTournaments.length) { %>
          <div class="panel notice">Турниры пока не заведены.</div>
        <% } else { %>
          <div class="tcards">
            <% homeTournaments.forEach(function (t) { %>
              <a class="tcard fx-card" href="/tournaments/<%= t.id %>">
                <div class="tcard__date"><b><%= dm(t.start_date || t.end_date) %></b><% if (t.start_date && t.start_date !== t.end_date) { %><span>— <%= dm(t.end_date) %></span><% } %></div>
                <div class="tcard__body">
                  <div class="tcard__name"><%= t.name %></div>
                  <div class="tcard__meta"><%= t.city || 'Смоленская область' %><%= t.age_group ? ' · ' + t.age_group : '' %><%= t.participants ? ' · участников: ' + t.participants : '' %></div>
                  <div class="tcard__tags"><span class="badge badge--<%= t.category.toLowerCase() %>"><%= t.category %></span> <span class="tag tag--<%= t.status %>"><%= statusRu[t.status] %></span></div>
                </div>
              </a>
            <% }); %>
          </div>
        <% } %>
        <p class="table-foot"><a class="link-more" href="/tournaments">Все турниры <span aria-hidden="true">→</span></a></p>
      </div>
      <aside class="reg-card fx-card"><%- include('partials/court-card') %>
        <h3>Регистрация онлайн</h3>
        <p class="reg-card-lead"><%= texts.cabinetLead %></p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Личный кабинет игрока и история результатов</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Заявка на регистрацию и на проведение турнира онлайн</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Приём документов от секретарей турниров с модерацией перед публикацией</li>
        </ul>
        <a class="btn btn--primary" href="/cabinet">Личный кабинет</a>
      </aside>
    </div>
  </div>
</section>

<%
/* ЖИВОЙ блок: ТОП-5 из последнего снимка rating_cache. «Изменение» считается
   на уровне сайта (два последних снимка), как и на /rating. */
%>
<section class="section-pad" id="rating">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Региональный рейтинг</span>
      <h2>Лидеры рейтинга</h2>
      <% if (standings) { %>
        <div class="rating-meta">
          <span class="tag"><%= statusText %></span>
          <span class="tag">на <%= standings.asOf %></span>
        </div>
      <% } %>
    </div>

    <% if (!standings) { %>
      <div class="panel notice notice--warn">
        Рейтинг ещё не рассчитан. Таблица появится после первого пересчёта в админке.
      </div>
    <% } else if (top5.length === 0) { %>
      <div class="panel notice">В последнем снимке рейтинга нет игроков.</div>
    <% } else { %>
      <%
      /* ТОП-10 с переключателем «Все / Мужчины / Женщины» (как у ФТР): три таблицы в разметке,
         переключение классом без перезагрузки; без JS видны все три подряд. */
      %>
      <div class="top-tabs" role="tablist" aria-label="Топ рейтинга">
        <button class="tag top-tab is-active" type="button" data-top-tab="all">Все</button>
        <button class="tag top-tab" type="button" data-top-tab="M">Мужчины</button>
        <button class="tag top-tab" type="button" data-top-tab="F">Женщины</button>
      </div>
      <% [['all', topBySex.all], ['M', topBySex.M], ['F', topBySex.F]].forEach(function (pair) { const key = pair[0], list = pair[1]; %>
        <div class="table-scroll top-panel" data-top-panel="<%= key %>"<%= key === 'all' ? '' : ' hidden' %>>
          <% if (!list.length) { %><p class="muted">В этом рейтинге пока нет игроков.</p><% } else { %>
          <table>
            <thead><tr><th>Место</th><th>Игрок</th><th>Город</th><th>Очки</th><th>Изменение</th></tr></thead>
            <tbody>
              <% list.forEach(function (p, i) { %>
                <tr>
                  <td class="rank"><%= key === 'all' ? p.rank : i + 1 %></td>
                  <td class="player<%= p.anonymized ? ' player--anonymized' : '' %>"><% if (p.anonymized) { %><%= p.playerName %><% } else { %><a href="/player/<%= p.playerId %>"><%= p.playerName %></a><% } %></td>
                  <td><%= p.city || '—' %></td>
                  <td class="pts"><%= p.ratingPoints %></td>
                  <td class="chg chg--<%= p.change.kind %>"><%= p.change.label %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>
      <% }); %>
    <% } %>

    <p class="rules-note">Рейтинг рассчитывается по регламенту ФТСО: учитываются <%= rules.countBest %> лучших турниров за последние 52 недели, коэффициент категории A × <%= rules.categoryCoef.A %>, B × <%= rules.categoryCoef.B %>, C × <%= rules.categoryCoef.C %>.</p>
    <p class="table-foot"><a class="link-more" href="/rating">Полный рейтинг <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<%
/* Новостной блок — ЖИВЫЕ данные: три последние опубликованные новости. */
%>
<section class="section-pad section-wm">
  <svg class="wm wm--news" data-parallax=".12" viewBox="0 0 300 400" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="10" y="10" width="280" height="380" rx="2"/><line x1="10" y1="200" x2="290" y2="200"/><rect x="45" y="70" width="210" height="260"/><line x1="150" y1="70" x2="150" y2="330"/><line x1="45" y1="200" x2="255" y2="200"/></svg>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Новости</span>
      <h2>Актуальное</h2>
    </div>
    <% if (!news.length) { %>
      <div class="panel notice">Новостей пока нет.</div>
    <% } else { %>
      <div class="news-grid">
        <% news.forEach(function (n) { %>
          <article class="news-card fx-card">
            <%- include('partials/court-card') %>
            <span class="news-date"><%= n.published_at || n.created_at.slice(0, 10) %></span>
            <h3><%= n.title %></h3>
            <p><%= n.summary || '' %></p>
            <a class="link-more" href="/news/<%= n.id %>">Читать <span aria-hidden="true">→</span></a>
          </article>
        <% }); %>
      </div>
    <% } %>
    <p class="table-foot"><a class="link-more" href="/news">Все новости <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<%
/* Обе кнопки ЖИВЫЕ: регистрация игрока и заявка на проведение турнира. */
%>
<section class="section-pad section-pad--tight">
  <div class="container">
    <div class="cta-inner fx-card">
      <svg class="court-watermark" data-parallax=".16" viewBox="0 0 300 400" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <rect x="10" y="10" width="280" height="380" rx="2"/>
        <line x1="10" y1="200" x2="290" y2="200"/>
        <rect x="45" y="70" width="210" height="260"/>
        <line x1="150" y1="70" x2="150" y2="330"/>
      </svg>
      <h2>Играете в теннис — вставайте в рейтинг</h2>
      <p>Заявляйтесь на турниры онлайн, отслеживайте результаты и своё место в региональном рейтинге ФТСО.</p>
      <div class="cta-actions">
        <a class="btn btn--white" href="/register">Регистрация игрока</a>
        <a class="btn btn--outline-white" href="/tournament-request">Провести турнир</a>
      </div>
    </div>
  </div>
</section>

</main>

<%- include('partials/footer') %>
