<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Профиль игрока</span>
    <div class="profile-head">
      <% if (profile.hasPhoto) { %>
        <img class="profile-photo" src="/player/<%= profile.id %>/photo" alt="Фотография: <%= profile.fullName %>" width="160" height="160">
      <% } %>
      <div>
        <%
        /* ЭКРАНИРОВАНИЕ: всё из БД — только через экранирующий тег. */
        %>
        <h1><%= profile.fullName %></h1>
        <div class="rating-meta">
          <span class="tag"><%= profile.city %></span>
          <% if (profile.rni) { %><span class="tag">РНИ <%= profile.rni %></span><% } %>
          <span class="tag"><%= sexRu[profile.sex] || profile.sex %></span>
          <span class="tag">возраст: <%= profile.ageLabel %></span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad section-pad--tight">
  <div class="container stack">
    <div class="panel">
      <h2>Рейтинг</h2>
      <% if (!profile.rating) { %>
        <p class="muted">Рейтинг ещё не рассчитан.</p>
      <% } else { %>
        <div class="table-scroll">
          <table class="rating-table">
            <caption class="visually-hidden">Место и очки игрока по разрядам</caption>
            <thead><tr><th scope="col">Разряд</th><th scope="col">Место</th><th scope="col">Очки</th><th scope="col">Турниров в окне</th><th scope="col">Зачтено</th><th scope="col">Изменение</th></tr></thead>
            <tbody>
              <% ['single', 'double'].forEach(function (d) { var r = profile.rating[d]; %>
                <tr>
                  <td><%= disciplineRu[d] %></td>
                  <% if (r) { %>
                    <td class="rank"><%= r.rank %></td>
                    <td class="pts"><%= r.ratingPoints %></td>
                    <td><%= r.totalInWindow %></td>
                    <td><% if (Array.isArray(r.counted)) { %><%= r.counted.length %><% if (r.counted.length) { %> <span class="muted">(<%= r.counted.map(function (e) { return e.name + ' — ' + e.points; }).join('; ') %>)</span><% } %><% } else { %><%= r.counted %><% } %></td>
                    <td class="chg chg--<%= r.change.kind %>"><%= r.change.label %></td>
                  <% } else { %>
                    <td colspan="5" class="muted">нет в рейтинге</td>
                  <% } %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (history.best) { %>
          <p class="rating-summary"><strong>Наивысшее место:</strong> <%= history.best.rank %> (<%= history.best.asOf %>)</p>
        <% } %>
        <% if (history.points.length > 1) { %>
          <%
          /* ГРАФИК РЕЙТИНГА (идея ФТР/TennisNET): место по месяцам, ось перевёрнута —
             1-е место сверху. Инлайн-SVG в цветах темы (палитра не тронута). */
          const pts = history.points;
          const W = 640, H = 180, padL = 36, padR = 12, padT = 14, padB = 28;
          const maxRank = Math.max(...pts.map((p) => p.rank), 2);
          const x = (i) => padL + (pts.length === 1 ? 0 : i * (W - padL - padR) / (pts.length - 1));
          const y = (r) => padT + (r - 1) * (H - padT - padB) / (maxRank - 1);
          const path = pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.rank).toFixed(1)}`).join(' ');
          %>
          <h3 class="chart-title">Место в рейтинге по месяцам (одиночный разряд)</h3>
          <svg class="rating-chart" viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="График места в рейтинге по месяцам">
            <line x1="<%= padL %>" y1="<%= padT %>" x2="<%= padL %>" y2="<%= H - padB %>" class="rc-axis"/>
            <line x1="<%= padL %>" y1="<%= H - padB %>" x2="<%= W - padR %>" y2="<%= H - padB %>" class="rc-axis"/>
            <text x="<%= padL - 6 %>" y="<%= padT + 4 %>" class="rc-label" text-anchor="end">1</text>
            <text x="<%= padL - 6 %>" y="<%= H - padB + 4 %>" class="rc-label" text-anchor="end"><%= maxRank %></text>
            <path d="<%= path %>" class="rc-line"/>
            <% pts.forEach(function (p, i) { %>
              <circle cx="<%= x(i).toFixed(1) %>" cy="<%= y(p.rank).toFixed(1) %>" r="4" class="rc-dot"><title><%= p.month %>: место <%= p.rank %>, очков <%= p.points %></title></circle>
              <% if (i === 0 || i === pts.length - 1 || pts.length <= 8) { %><text x="<%= x(i).toFixed(1) %>" y="<%= H - padB + 16 %>" class="rc-label" text-anchor="middle"><%= p.month %></text><% } %>
            <% }); %>
          </svg>
          <div class="table-scroll">
            <table class="rating-table rating-history">
              <caption class="visually-hidden">История места и очков по месяцам</caption>
              <thead><tr><th scope="col">Месяц</th><th scope="col">Место</th><th scope="col">Очки</th></tr></thead>
              <tbody><% pts.slice().reverse().forEach(function (p) { %><tr><td><%= p.month %></td><td class="rank"><%= p.rank %></td><td class="pts"><%= p.points %></td></tr><% }); %></tbody>
            </table>
          </div>
        <% } %>
        <p class="rating-summary muted">
          <%= statusText %> · актуальность <%= profile.rating.asOf %> · обновлён <%= profile.rating.computedAt %> UTC.
          <% if (profile.slices.length) { %>
            Возрастные срезы:
            <% profile.slices.forEach(function (id, i) { %><%= i ? ', ' : '' %><a href="/rating?slice=<%= id %>"><%= sliceLabels.get(id) %></a><% }); %>.
          <% } %>
          <a class="link-more" href="/rating">К таблице рейтинга <span aria-hidden="true">→</span></a>
        </p>
      <% } %>
    </div>

    <div class="panel">
      <h2>Турниры</h2>
      <% if (!profile.results.length) { %>
        <p class="muted">Результатов ещё нет.</p>
      <% } else { %>
        <p class="muted">Всего турниров: <%= profile.tournamentsPlayed %>.</p>
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">Места игрока по турнирам</caption>
            <thead><tr><th scope="col">Дата</th><th scope="col">Турнир</th><th scope="col">Категория</th><th scope="col">Разряд</th><th scope="col">Место</th></tr></thead>
            <tbody>
              <% profile.results.forEach(function (r) { %>
                <tr>
                  <td><%= r.end_date %></td>
                  <td><a href="/tournaments/<%= r.tournament_id %>"><%= r.tournament_name %></a></td>
                  <td><%= r.category %></td>
                  <td><%= disciplineRu[r.discipline] %></td>
                  <td class="rank"><%= r.place %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="panel">
      <h2>Матчи</h2>
      <% if (!profile.matches.length) { %>
        <p class="muted">Сыгранных матчей ещё нет.</p>
      <% } else { %>
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">Сыгранные матчи игрока</caption>
            <thead><tr><th scope="col">Дата</th><th scope="col">Итог</th><th scope="col">Соперник</th><th scope="col">Счёт</th><th scope="col">Турнир</th></tr></thead>
            <tbody>
              <% profile.matches.forEach(function (m) { %>
                <tr class="match match--<%= m.won ? 'won' : 'lost' %>">
                  <td><%= m.playedOn %></td>
                  <td><%= m.won ? 'победа' : 'поражение' %><%= m.kind === 'double' ? ' · пара' : '' %></td>
                  <td>
                    <% m.opponents.forEach(function (o, i) { %><%= i ? ' / ' : '' %><% if (o.id) { %><a href="/player/<%= o.id %>"><%= o.name %></a><% } else { %><span class="player--anonymized"><%= o.name %></span><% } %><% }); %>
                    <% if (m.partner) { %>
                      <span class="muted">(в паре с <% if (m.partner.id) { %><a href="/player/<%= m.partner.id %>"><%= m.partner.name %></a><% } else { %><%= m.partner.name %><% } %>)</span>
                    <% } %>
                  </td>
                  <td><%= m.score || '—' %></td>
                  <td><a href="/tournaments/<%= m.tournament.id %>"><%= m.tournament.name %></a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</section>
</main>

<%- include('partials/footer') %>
