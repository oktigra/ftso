<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="top">
    <%
    /* ПЕРЕКЛЮЧАТЕЛЬ ВИДА (задача 4): ссылки несут текущие фильтры, сервер запоминает выбор cookie. */
    const qs = (extra) => {
      const p = new URLSearchParams();
      Object.keys(filters).forEach(function (k) {
        const v = filters[k];
        if (Array.isArray(v)) v.forEach(function (x) { p.append(k, x); }); else if (v) p.set(k, v);
      });
      Object.keys(extra).forEach(function (k) { if (extra[k]) p.set(k, extra[k]); else p.delete(k); });
      const str = p.toString();
      return '/tournaments' + (str ? '?' + str : '');
    };
    const MONTHS_FULL = ['январь', 'февраль', 'март', 'апрель', 'май', 'июнь', 'июль', 'август', 'сентябрь', 'октябрь', 'ноябрь', 'декабрь'];
    const monthTitle = (ym) => MONTHS_FULL[Number(ym.slice(5, 7)) - 1] + ' ' + ym.slice(0, 4);
    %>
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Раздел сайта</span>
    <div class="page-head__row">
      <h1>Турниры</h1>
      <nav class="tabs tabs--head" aria-label="Вид календаря">
        <a class="tabs__item<%= view === 'list' ? ' is-active' : '' %>" href="<%= qs({ view: 'list' }) %>"<%- view === 'list' ? ' aria-current="page"' : '' %>>Список</a>
        <a class="tabs__item<%= view === 'grid' ? ' is-active' : '' %>" href="<%= qs({ view: 'grid' }) %>"<%- view === 'grid' ? ' aria-current="page"' : '' %>>Сетка месяца</a>
      </nav>
    </div>
    <p class="muted">Календарь соревнований Федерации. Категория задаёт рейтинговый коэффициент.</p>
  </div>
</section>
<section class="section-pad section-pad--tight">
  <div class="container">
    <%
    /* Фильтры ТЗ п. 4.3: дата (месяц), город, категория, возраст, статус, тип.
       Обычная GET-форма без JS: адрес с фильтрами можно переслать. */
    const anyFilter = Object.values(filters).some(Boolean);
    %>
    <form method="get" action="/tournaments" class="filters" aria-label="Фильтры турниров">
        <div class="field">
          <label for="tf-month">Месяц</label>
          <select id="tf-month" name="month">
            <option value="">все</option>
            <% options.months.forEach(function (m) { %><option value="<%= m %>"<%= filters.month === m ? ' selected' : '' %>><%= m %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label for="tf-city">Город</label>
          <select id="tf-city" name="city">
            <option value="">все</option>
            <% options.cities.forEach(function (c) { %><option value="<%= c %>"<%= filters.city === c ? ' selected' : '' %>><%= c %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <%
          /* КАТЕГОРИЙ МОЖНО ВЫБРАТЬ НЕСКОЛЬКО (09.09.2026): «покажи B и C разом» раньше
             было нельзя. Флажки, а не select multiple: тот на телефоне требует долгого
             тапа с прокруткой, а здесь значений всего три. Пусто = все категории. */
          %>
          <fieldset class="field-group">
            <legend>Категория</legend>
            <% categories.forEach(function (c) { %>
              <label class="check"><input type="checkbox" name="category" value="<%= c %>"<%= filters.category.includes(c) ? ' checked' : '' %>> <%= c %></label>
            <% }); %>
          </fieldset>
        </div>
        <div class="field">
          <label for="tf-age">Возраст</label>
          <select id="tf-age" name="age">
            <option value="">все</option>
            <% options.ages.forEach(function (a) { %><option value="<%= a %>"<%= filters.age === a ? ' selected' : '' %>><%= a %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label for="tf-status">Статус</label>
          <select id="tf-status" name="status">
            <option value="">все</option>
            <% Object.keys(statusRu).forEach(function (k) { %><option value="<%= k %>"<%= filters.status === k ? ' selected' : '' %>><%= statusRu[k] %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label for="tf-entry">Приём заявок</label>
          <select id="tf-entry" name="entry">
            <option value="">Любой</option>
            <% Object.keys(entryRu).forEach(function (k) { %><option value="<%= k %>"<%= filters.entry === k ? ' selected' : '' %>><%= entryRu[k] %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label for="tf-sex">Пол</label>
          <select id="tf-sex" name="sex">
            <option value="">все</option>
            <% Object.keys(sexRu).forEach(function (k) { %><option value="<%= k %>"<%= filters.sex === k ? ' selected' : '' %>><%= sexRu[k] %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label for="tf-kind">Тип</label>
          <select id="tf-kind" name="kind">
            <option value="">все</option>
            <% Object.keys(kindRu).forEach(function (k) { %><option value="<%= k %>"<%= filters.kind === k ? ' selected' : '' %>><%= kindRu[k] %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label for="tf-format">Система</label>
          <select id="tf-format" name="format">
            <option value="">любая</option>
            <% Object.keys(formatRu).forEach(function (k) { %><option value="<%= k %>"<%= filters.format === k ? ' selected' : '' %>><%= formatRu[k] %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <button class="btn btn--secondary" type="submit">Показать</button>
        </div>
        <% if (anyFilter) { %><div class="field"><a class="btn btn--secondary" href="/tournaments">Сбросить</a></div><% } %>
    </form>
    <% if (view === 'grid') { %>
      <div class="cal">
        <div class="cal__nav">
          <a class="btn btn--secondary btn--small" href="<%= qs({ view: 'grid', gm: grid.prev }) %>" rel="nofollow">← <%= monthTitle(grid.prev) %></a>
          <h2 class="cal__title"><%= monthTitle(grid.month) %><span class="muted"> · турниров: <%= grid.count %></span></h2>
          <a class="btn btn--secondary btn--small" href="<%= qs({ view: 'grid', gm: grid.next }) %>" rel="nofollow"><%= monthTitle(grid.next) %> →</a>
        </div>
        <table class="cal__table" aria-label="Турниры по дням: <%= monthTitle(grid.month) %>">
          <thead><tr><% ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'].forEach(function (d) { %><th scope="col"><%= d %></th><% }); %></tr></thead>
          <tbody>
            <% grid.weeks.forEach(function (week) { %>
              <tr>
                <% week.forEach(function (cell) { %>
                  <% if (!cell) { %><td class="cal__cell cal__cell--empty"></td><% } else { %>
                    <td class="cal__cell<%= cell.items.length ? ' has-items' : '' %>">
                      <span class="cal__day"><%= cell.day %></span>
                      <% cell.items.forEach(function (t) { %>
                        <a class="cal__item cal__item--<%= t.status %><%= t.first ? ' is-first' : '' %>" href="/tournaments/<%= t.id %>" title="<%= t.name %><%= t.city ? ', ' + t.city : '' %> · кат. <%= t.category %>"><%= t.name %></a>
                      <% }); %>
                    </td>
                  <% } %>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else if (!tournaments.length) { %>
      <% if (anyFilter) { %>
        <div class="panel notice">По выбранным фильтрам турниров нет.</div>
      <% } else { %>
        <div class="panel notice notice--invite">
          <b>Календарь сезона собирается</b>
          <span>Здесь появятся турниры Федерации: даты, город, категория и статус. Организаторы могут заявить соревнование в календарь.</span>
          <a class="btn btn--secondary btn--small" href="/tournament-request">Заявить турнир</a>
        </div>
      <% } %>
    <% } else { %>
      <%
      /* ЯЩИКИ ТУРНИРОВ (08.09.2026): та же конструкция, что на главной, но карточек
         тут десятки — своя сетка на три колонки (--calendar) и год в дате, потому что
         календарь копится сезонами. Все девять колонок прежней таблицы на месте:
         даты, название, город, тип, возраст, пол, категория, статус, участники.
         Корпус не ссылка целиком — ссылками служат фасад и три папки, иначе получились
         бы вложенные ссылки; с клавиатуры ящик раскрывается табом (:focus-within). */
      const year = (d) => (d ? ' ' + d.slice(0, 4) : '');
      %>
      <ul class="tdrawers tdrawers--calendar">
        <% tournaments.forEach(function (t) { %>
          <li class="tdrawer">
            <div class="tdrawer__box">
              <div class="tdrawer__folders">
                <a class="tdrawer__folder" href="/tournaments/<%= t.id %>#grid">Сетка</a>
                <a class="tdrawer__folder" href="/tournament-request">Заявка</a>
                <a class="tdrawer__folder" href="/documents">Регламент</a>
              </div>
              <a class="tdrawer__face" href="/tournaments/<%= t.id %>">
                <div class="tdrawer__top">
                  <span class="tdrawer__date"><%= dm(t.start_date || t.end_date) %><% if (t.start_date && t.start_date !== t.end_date) { %> — <%= dm(t.end_date) %><% } %><%= year(t.end_date || t.start_date) %></span>
                  <span class="badge badge--<%= t.category.toLowerCase() %>">Кат. <%= t.category %></span>
                </div>
                <div class="tdrawer__name"><%= t.name %></div>
                <div class="tdrawer__meta"><%= t.city || 'Смоленская область' %> · <%= kindRu[t.kind] || 'турнир' %><%= t.format ? ' · ' + formatRu[t.format] : '' %><%= t.participants ? ' · участников: ' + t.participants : '' %></div>
                <div class="tdrawer__tags">
                  <span class="tag tag--<%= t.status %>"><%= statusRu[t.status] %></span>
                  <% if (t.status === 'upcoming' || filters.entry) { %><span class="tag tag--entry-<%= t.entry %>" title="Заявки до <%= t.entryDeadline ? t.entryDeadline.split('-').reverse().join('.') : '' %>"><%= entryRu[t.entry] %></span><% } %>
                  <% if (t.age_group) { %><span class="tag"><%= t.age_group %></span><% } %>
                  <% if (t.sex) { %><span class="tag"><%= sexRu[t.sex] %></span><% } %>
                </div>
                <div class="tdrawer__handle" aria-hidden="true"></div>
              </a>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
    <p class="table-foot"><a class="link-more" href="/tournament-request">Провести свой турнир <span aria-hidden="true">→</span></a></p>
  </div>
</section>
</main>
<%- include('partials/footer') %>
