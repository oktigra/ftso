<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="top">
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Раздел сайта</span>
    <h1>Галерея</h1>
  </div>
</section>
<section class="section-pad section-pad--tight">
  <div class="container">
    <% if (!items.length) { %>
      <div class="panel notice">Фотографий пока нет.</div>
    <% } else { %>
      <%
      /* Снимки показываются картинками через /gallery/:id/image. Это безопасно:
         профиль gallery пропускает только растровые изображения по сигнатуре
         байтов (SVG не проходит), отдача — с nosniff и mime из базы. */
      %>
      <%
      /* Полноэкранный просмотр (ТЗ 4.8): <dialog> в app.js, листание ←/→, Esc.
         Без JS ссылка открывает сам файл — это тоже полный экран. */
      %>
      <ul class="gallery-grid" data-gallery>
        <% items.forEach(function (g, i) { %>
          <li>
            <figure>
              <a href="/gallery/<%= g.id %>/image" class="gallery-link" data-gallery-item data-index="<%= i %>" data-caption="<%= g.title %><%= g.tournament_name ? ' — ' + g.tournament_name : '' %>">
                <img src="/gallery/<%= g.id %>/image" alt="<%= g.title %>" loading="lazy">
              </a>
              <figcaption>
                <%= g.title %>
                <% if (g.tournament_name) { %><span class="muted"> — <%= g.tournament_name %><%= g.tournament_date ? ", " + g.tournament_date : "" %></span><% } %>
              </figcaption>
            </figure>
          </li>
        <% }); %>
      </ul>
      <dialog class="lightbox" data-lightbox aria-label="Просмотр фотографии">
        <button class="lightbox__close" type="button" data-lightbox-close aria-label="Закрыть">×</button>
        <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Предыдущая">‹</button>
        <figure class="lightbox__figure">
          <img class="lightbox__img" src="" alt="">
          <figcaption class="lightbox__caption"></figcaption>
        </figure>
        <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Следующая">›</button>
      </dialog>
    <% } %>
    <div class="panel notice gallery-legal">
      <p><strong>Репортажная съёмка соревнований.</strong> Снимки сделаны на открытых спортивных
      мероприятиях Федерации и публикуются без отдельного согласия изображённых лиц на
      основании подп. 2 п. 1 ст. 152.1 ГК РФ (съёмка на публичных мероприятиях, в том числе
      спортивных соревнованиях). Перед публикацией файлы пересобираются: служебные данные
      снимка (геолокация, модель камеры) удаляются.</p>
      <p>Если вы есть на снимке и хотите его убрать — напишите нам через
      <a href="/contacts">страницу контактов</a>, снимем.</p>
    </div>
  </div>
</section>
</main>
<%- include('partials/footer') %>
