# Образец окружения. РЕАЛЬНЫЙ .env в git НЕ кладётся (см. .gitignore).
# Скопируй: cp .env.example .env — и заполни своими значениями.

# ОБЯЗАТЕЛЬНО. Секрет подписи сессии. Можно перечислить через запятую несколько:
# первый подписывает, остальные принимают уже выданные cookie -> ротация секрета
# без разлогина всех. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=замени-на-случайную-строку

# ОБЯЗАТЕЛЬНО. Пароль супер-админа берётся ОТСЮДА, не из кода.
# СМЕНИТЬ ПРИ ПЕРВОМ ВХОДЕ через админку (Мой аккаунт -> Смена пароля).
SUPER_ADMIN_PASSWORD=замени-на-длинный-пароль
SUPER_ADMIN_USERNAME=admin

# Пароль тестового пользователя роли tournament-admin (создаётся сидом).
TOURNAMENT_ADMIN_PASSWORD=замени-на-длинный-пароль

# production включает Secure-cookie и HSTS. В dev по HTTP оставь пустым/development.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# За обратным прокси (nginx/Caddy) поставь 1 — иначе req.ip = адрес прокси,
# и блокировка по «логин+IP» схлопнется, а Secure-cookie не распознает HTTPS.
TRUST_PROXY=0

# Файл SQLite. В git не попадает.
DB_FILE=./db/ftso.sqlite
DB_TIMEOUT_MS=5000

# Лимит попыток входа: 5 неудач на пару «логин+IP», 20 на IP, блок 15 минут.
LOGIN_MAX_ACCOUNT_FAILS=5
LOGIN_MAX_IP_FAILS=20
LOGIN_LOCK_MINUTES=15

# Общий лимит POST-действий админки.
WRITE_MAX_PER_WINDOW=120
WRITE_WINDOW_MINUTES=15

# Рейтинг: сброс протухшего лока, минимальный интервал между пересчётами
# (защита от двойного нажатия), глубина хранения снимков, потолок участников.
RATING_STALE_LOCK_MINUTES=5
RATING_MIN_INTERVAL_SECONDS=10
RATING_KEEP_SNAPSHOTS=24
TOURNAMENT_MAX_PARTICIPANTS=256

# ПОЧТА (SMTP Яндекса). Без SMTP_USER/SMTP_PASS отправка выключена: письма
# копятся в очереди и видны в админке — заявки при этом принимаются.
# SMTP_PASS — ПАРОЛЬ ПРИЛОЖЕНИЯ Яндекса, не пароль от ящика. В git не попадает.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# 465 -> TLS сразу. Для 587 (STARTTLS) поставь 0.
SMTP_SECURE=1
SMTP_USER=info@ftso67.ru
SMTP_PASS=замени-на-пароль-приложения
# Отправитель. Яндекс требует совпадения с SMTP_USER — пустое значение подставит его.
MAIL_FROM=
# Повтор застрявших писем: раз в N минут, после M неудач письмо помечается
# «не удалось» и ждёт кнопки в админке.
MAIL_RETRY_MINUTES=10
MAIL_FAIL_AFTER=8

# Публичная форма регистрации: лимит заявок с одного адреса и срок хранения
# ОТКЛОНЁННЫХ и брошенных заявок (одобренные живут вместе с игроком).
REGISTER_MAX_PER_WINDOW=5
REGISTER_WINDOW_MINUTES=60
REGISTRATION_RETENTION_DAYS=365

# Публичная заявка «провести турнир»: лимит подач с адреса, срок хранения
# отклонённых и брошенных заявок (вместе с приложенными файлами), число файлов.
TOURNAMENT_REQUEST_MAX_PER_WINDOW=3
TOURNAMENT_REQUEST_WINDOW_MINUTES=60
TOURNAMENT_REQUEST_RETENTION_DAYS=365
TOURNAMENT_REQUEST_MAX_FILES=3

# Каталог загруженных файлов. ВНЕ webroot: по умолчанию site/storage/uploads.
UPLOAD_DIR=

# Личный кабинет: лимит попыток входа и сброса пароля с одного адреса.
CABINET_MAX_PER_WINDOW=15
CABINET_WINDOW_MINUTES=15

# Журнал согласий: срок хранения ОТОЗВАННЫХ записей, в днях. Отсчёт от отзыва.
# Действующее согласие не чистится никогда — оно основание обработки.
# 1095 = 3 года (общий срок исковой давности).
CONSENT_RETENTION_DAYS=1095

# Срок хранения данных ЗАКОННОГО ПРЕДСТАВИТЕЛЯ, в днях. Отсчёт от снятия
# представителя (совершеннолетие участника или замена), а НЕ от даты записи:
# пока представитель действует, его данные — основание обработки данных ребёнка.
# 1095 = 3 года, подтверждено заказчиком (общий срок исковой давности).
GUARDIAN_RETENTION_DAYS=1095

# Адрес сайта для писем фоновой проверки (переход участника в 18 лет): у неё нет
# HTTP-запроса, из которого можно взять хост.
SITE_URL=https://ftso67.ru

# Лимит тела запроса.
BODY_LIMIT=100kb

# ─── РЕЖИМ РАЗРАБОТКИ И ПРИЁМ ПЕРСОНАЛЬНЫХ ДАННЫХ ───────────────────────────
# Рубильник приёма ПДн. Пункт 11 «Порядка к запуску» (BACKLOG.md):
# публичный приём реальных персональных данных открывается ТОЛЬКО после того,
# как (1) оператор появится в реестре Роскомнадзора (ст. 22 152-ФЗ) и
# (2) на домене встанет SSL.
#   0 или не задано — приём ЗАКРЫТ: формы регистрации, заявки на турнир и
#     личный кабинет отдают заглушку, POST отклоняется с 403 до записи в БД.
#     Закрыты и ПДн-действия админки (заведение игроков, одобрение заявок,
#     пересчёт рейтинга, справочники тренеров и судей). Контент — новости,
#     турниры, документы, корты, клубы — наполняется как обычно.
#   1 — приём открыт. Это ЕДИНСТВЕННОЕ изменение, которое требуется для
#     запуска: кода править не нужно.
INTAKE_ENABLED=0

# Баннер «Сайт находится в режиме разработки».
# Отдельный флаг: сайт может уже законно принимать данные, но всё ещё
# дорабатываться. Фраза «Сбор персональных данных не осуществляется»
# показывается ТОЛЬКО при INTAKE_ENABLED=0 и снимается автоматически —
# руками текст править не нужно и нельзя забыть.
#   с 05.09.2026: не задано или 0 — баннер держится САМ, пока в базе нет ни одного
#   результата соревнований, и уходит с первым результатом; 1 — показывать всегда
DEV_NOTICE=0

# Письма сайта: off (по умолчанию) — сайт писем не отправляет, восстановление пароля кабинета
# идёт через секретаря (ссылка выдаётся в «Игроках» → «Ссылка в кабинет»); on — включить
# отправку (нужен рабочий SMTP, платный тариф Яндекс 360).
SITE_MAIL=off

# Кнопка «Написать в MAX» (подвал и Контакты). По умолчанию — канал федерации
# https://max.ru/channel_ftso (в коде). Другой адрес — только https://max.ru/…;
# MAX_URL=off — выключить кнопку.
MAX_URL=

# Яндекс.Метрика: по умолчанию — счётчик федерации 112305908 (в коде). Другой номер —
# только цифры; METRIKA_ID=off — выключить (ни баннера, ни скрипта). Счётчик грузится
# ТОЛЬКО после «Принять» в баннере, выбор хранится в cookie ftso.analytics на 1 год.
METRIKA_ID=

# «Сохранить данные для входа»: срок сессии с отметкой, дней (по умолчанию 90 — решение владельца 05.09.2026).
REMEMBER_DAYS=90
